اختبار.مجموعة("المزج والعمليات", دالة() {
  خل احمر = رئيسي.لون.من_هيكس("#ff0000"); خل ازرق = رئيسي.لون.من_هيكس("#0000ff")
  اختبار.اختبر("مزج في مساحات مختلفة (قيم مرجعية من coloraide)", دالة() {
    اختبار.يساوي(احمر.امزج(ازرق, 0.3, "rgb").هيكس(), "#b3004d")
    اختبار.يساوي(احمر.امزج(ازرق, 0.3, "linear").هيكس(), "#da0095")
    اختبار.يساوي(احمر.امزج(ازرق, 0.3, "hsl").هيكس(), "#ff0099")
    اختبار.يساوي(احمر.امزج(ازرق, 0.3, "oklab").هيكس(), "#ba4d79")
    اختبار.يساوي(احمر.امزج(ازرق, 0.3, "oklch").هيكس(), "#d60088")
    اختبار.يساوي(احمر.امزج(ازرق, 0.3, "lch").هيكس(), "#e4005e")
  })
  اختبار.اختبر("أطراف المزج", دالة() {
    اختبار.يساوي(احمر.امزج(ازرق, 0).هيكس(), "#ff0000")
    اختبار.يساوي(احمر.امزج(ازرق, 1).هيكس(), "#0000ff")
  })
  اختبار.اختبر("تعيين النطاق: لا قنوات خارج 0..255", دالة() {
    خل ل = رئيسي.لون.من_oklch(0.7, 0.45, 150)
    اختبار.هو_صح(ل.r >= 0 و ل.r <= 255 و ل.g >= 0 و ل.g <= 255 و ل.b >= 0 و ل.b <= 255)
  })
  اختبار.اختبر("تفتيح وتغميق ولف", دالة() {
    اختبار.يساوي(احمر.افتح(0.2).هيكس(), "#ff6666")
    اختبار.يساوي(رئيسي.لون.من_هيكس("#336699").لف(90).هيكس(), "#993399")
    اختبار.يساوي(احمر.مكمل().هيكس(), "#00ffff")
    اختبار.يساوي(احمر.اعكس().هيكس(), "#00ffff")
  })
  اختبار.اختبر("أوضاع الدمج", دالة() {
    خل أ = رئيسي.لون.من_هيكس("#ff8844"); خل ب = رئيسي.لون.من_هيكس("#4488ff")
    اختبار.يساوي(أ.دمج_وضع(ب, "multiply").هيكس(), "#444944")
    اختبار.يساوي(أ.دمج_وضع(ب, "screen").هيكس(), "#ffc7ff")
    اختبار.يرمي(دالة() { أ.دمج_وضع(ب, "غير_موجود") })
  })
  اختبار.اختبر("الشفافية والتركيب", دالة() {
    خل ش = رئيسي.لون.من_نص("rgba(255,0,0,0.5)")
    اختبار.يساوي(ش.ركب(رئيسي.لون(0, 0, 0)).هيكس(), "#800000")
  })
  اختبار.اختبر("التناسق والدرجات", دالة() {
    اختبار.يساوي(احمر.تناسق("ثلاثي").طول, 3)
    اختبار.يساوي(احمر.تناسق("رباعي").طول, 4)
    خل د = رئيسي.لون.من_هيكس("#336699").درجات(9)
    اختبار.يساوي(د.طول, 9)
    اختبار.هو_صح(د[0].لمعان() > د[4].لمعان() و د[4].لمعان() > د[8].لمعان())
  })
  اختبار.اختبر("أقرب اسم", دالة() {
    اختبار.يساوي(رئيسي.لون.من_هيكس("#ff6347").اقرب_اسم(), "tomato")
  })
})

