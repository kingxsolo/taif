استورد "اختبار"
استورد "../رئيسي"

خل ESC = "\x1b"
دالة اسطر_متساوية(ن) {
  خل ع = رئيسي.طول_مرئي(ن.قسم("\n")[0])
  لكل س في ن.قسم("\n") { اذا رئيسي.طول_مرئي(س) != ع { ارجع غلط } }
  ارجع صح
}

اختبار.مجموعة("تحويلات الألوان", دالة() {
  اختبار.اختبر("هيكس ذهاباً وإياباً", دالة() {
    اختبار.يساوي(رئيسي.لون.من_هيكس("#ff8800").هيكس(), "#ff8800")
    اختبار.يساوي(رئيسي.لون.من_هيكس("f80").هيكس(), "#ff8800")
    اختبار.يساوي(رئيسي.لون.من_هيكس("#ff880080").هيكس(), "#ff880080")
  })
  اختبار.اختبر("HSL", دالة() {
    خل ح = رئيسي.لون.من_هيكس("#336699").hsl()
    اختبار.قريب(ح[0], 210, 0.01); اختبار.قريب(ح[1], 0.5, 0.001); اختبار.قريب(ح[2], 0.4, 0.001)
    اختبار.يساوي(رئيسي.لون.من_hsl(120, 1, 0.5).هيكس(), "#00ff00")
  })
  اختبار.اختبر("Lab وOKLab وOKLCH للأحمر (قيم مرجعية)", دالة() {
    خل ا = رئيسي.لون.من_هيكس("#ff0000")
    خل ل = ا.lab(); اختبار.قريب(ل[0], 53.24, 0.01); اختبار.قريب(ل[1], 80.09, 0.01); اختبار.قريب(ل[2], 67.20, 0.01)
    خل ك = ا.oklab(); اختبار.قريب(ك[0], 0.6280, 0.0005); اختبار.قريب(ك[1], 0.2249, 0.0005); اختبار.قريب(ك[2], 0.1258, 0.0005)
    خل ش = ا.oklch(); اختبار.قريب(ش[1], 0.2577, 0.0005); اختبار.قريب(ش[2], 29.23, 0.05)
  })
  اختبار.اختبر("ذهاب وإياب عبر كل المساحات", دالة() {
    لكل م في ["rgb", "linear", "hsl", "hsv", "hwb", "lab", "lch", "oklab", "oklch"] {
      خل ا = رئيسي.لون.من_هيكس("#3a7bd5")
      اختبار.يساوي(رئيسي.لون.من_مساحة(م, ا.الى(م)).هيكس(), "#3a7bd5")
    }
  })
  اختبار.اختبر("CMYK", دالة() {
    اختبار.يساوي(رئيسي.لون.من_هيكس("#ff0000").cmyk(), [0, 1, 1, 0])
    اختبار.يساوي(رئيسي.لون.من_cmyk(0, 1, 1, 0).هيكس(), "#ff0000")
    اختبار.يساوي(رئيسي.لون.من_هيكس("#000000").cmyk(), [0, 0, 0, 1])
  })
  اختبار.اختبر("درجة الحرارة", دالة() {
    اختبار.يساوي(رئيسي.لون.من_درجة_حرارة(2700).هيكس(), "#ffa757")
  })
})

