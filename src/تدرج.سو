// تدرج: تدرجات لونية للنصوص والخلفيات والأشرطة، ومقاييس ألوان
استورد "رياضيات"
استورد "./لونيات"
استورد "./بيانات"
استورد "./اساس"

خل _قوس = ["#ff0000", "#ffff00", "#00ff00", "#00ffff", "#0000ff", "#ff00ff", "#ff0000"]

دالة _ككائن(ل) { ارجع نوع(ل) == "نص" ? لونيات.لون.من_نص(ل) : ل }

// يحوّل «مصدراً» (اسم تدرج جاهز أو قائمة ألوان) إلى {محطات, مساحة}
دالة حلل_مصدر(مصدر) {
  اذا نوع(مصدر) == "نص" {
    خل ك = لونيات.طبع_عربي(مصدر)
    خل اسم = بيانات.تدرجات_بديلة.احصل(مصدر.صغير()) ?? مصدر
    اسم = لونيات.طبع_عربي(اسم)
    اذا اسم == "قوس_قزح" { ارجع {"محطات": _قوس.حول(لونيات.لون.من_نص), "مساحة": "hsl"} }
    لكل ن, ق في بيانات.تدرجات {
      اذا لونيات.طبع_عربي(ن) == اسم { ارجع {"محطات": ق.حول(لونيات.لون.من_نص), "مساحة": "oklab"} }
    }
    ارمي "تدرج غير معروف: ${مصدر}"
  }
  اذا نوع(مصدر) == "قائمة" {
    اذا مصدر.طول == 0 { ارمي "قائمة الألوان فارغة" }
    ارجع {"محطات": مصدر.حول(_ككائن), "مساحة": "oklab"}
  }
  ارمي "مصدر التدرج يجب أن يكون اسماً أو قائمة ألوان"
}
دالة اسماء_التدرجات() {
  خل خ = ["قوس_قزح"]
  لكل ن, ق في بيانات.تدرجات { خ.اضف(ن) }
  ارجع خ
}

// لون عند نقطة ت (0..1) من المصدر. دوري: يلف حول الدائرة · ارتداد: ذهاباً وإياباً
دالة لون_عند(مصدر, ت, مساحة = عدم, دوري = غلط, ارتداد = غلط) {
  خل ح = نوع(مصدر) == "قاموس" ? مصدر : حلل_مصدر(مصدر)
  اذا دوري { ت = ت - رياضيات.ارضي(ت) }
  اذا ارتداد { ت = ت - رياضيات.ارضي(ت / 2) * 2; ت = ت > 1 ? 2 - ت : ت }
  ارجع لونيات.عند(ح["محطات"], ت, مساحة ?? ح["مساحة"])
}

// قائمة من ن لوناً موزعة على المصدر
دالة سلم(مصدر, ن, مساحة = عدم) {
  خل ح = حلل_مصدر(مصدر)
  خل خ = []
  لكل ي في مدى(0, ن) { خ.اضف(لون_عند(ح, ن == 1 ? 0 : ي / (ن - 1), مساحة)) }
  ارجع خ
}

دالة _ف(ل, خلفية) {
  اذا ليس خلفية { ارجع [["f", "r", [ل.r, ل.g, ل.b]]] }
  خل ن = ل.نص_مناسب()
  ارجع [["f", "r", [ن.r, ن.g, ن.b]], ["b", "r", [ل.r, ل.g, ل.b]]]
}

// تدرج على نص. الخيارات (كلها اختيارية):
//   وضع: "حرف" (افتراضي) · "كلمة" (يحفظ وصل الحروف العربية) · "سطر"
//   اتجاه: "افقي" (افتراضي) · "عمودي" · "قطري"
//   مساحة: مساحة المزج · خلفية: صح لتلوين الخلفية (والنص يُختار تلقائياً)
//   ازاحة: إزاحة 0..1 على المصدر (للحركة) · دوري · ارتداد
دالة تدرج(ن, مصدر, خيارات = {}) {
  اذا اساس.مستوى() == 0 { ارجع نص(ن) }
  خل ح = حلل_مصدر(مصدر)
  خل وضع = خيارات.احصل("وضع", "حرف"); خل اتجاه = خيارات.احصل("اتجاه", "افقي")
  خل مساحة = خيارات.احصل("مساحة", ح["مساحة"]); خل خلفية = خيارات.احصل("خلفية", غلط)
  خل ازاحة = خيارات.احصل("ازاحة", 0); خل دوري = خيارات.احصل("دوري", غلط); خل ارتداد = خيارات.احصل("ارتداد", غلط)
  خل سطور = نص(ن).قسم("\n")
  خل اقصى_عرض = 1
  لكل س في سطور { خل ط = اساس.احرف(اساس.ازل(س)).طول; اذا ط > اقصى_عرض { اقصى_عرض = ط } }
  خل عدد_سطور = سطور.طول
  خل خارج = []
  لكل ر, س في سطور {
    خل مجموعات = اساس.احرف(اساس.ازل(س))
    // مقاطع: [نص، بداية، طول]
    خل مقاطع = []
    اذا وضع == "كلمة" {
      خل حالي = ""; خل بداية = 0; خل ط = 0
      لكل ف, م في مجموعات {
        اذا م == " " {
          اذا حالي != "" { مقاطع.اضف([حالي, بداية, ط]); حالي = ""; ط = 0 }
          مقاطع.اضف([" ", ف, 1])
        } والا {
          اذا حالي == "" { بداية = ف }
          حالي += م; ط += 1
        }
      }
      اذا حالي != "" { مقاطع.اضف([حالي, بداية, ط]) }
    } والا_اذا وضع == "سطر" {
      مقاطع.اضف([مجموعات.ادمج(""), 0, مجموعات.طول])
    } والا {
      لكل ف, م في مجموعات { مقاطع.اضف([م, ف, 1]) }
    }
    خل ناتج = []
    لكل م في مقاطع {
      اذا م[0] == " " { ناتج.اضف(خلفية ? اساس.طبق(_ف(لون_عند(ح, ازاحة, مساحة, دوري, ارتداد), خلفية), " ") : " "); استمر }
      خل مركز = م[1] + م[2] / 2
      خل ت = 0
      اذا اتجاه == "عمودي" { ت = عدد_سطور <= 1 ? 0 : ر / (عدد_سطور - 1) }
      والا_اذا اتجاه == "قطري" { ت = (مركز + ر * 2) / رياضيات.اكبر(1, اقصى_عرض + (عدد_سطور - 1) * 2) }
      والا { ت = اقصى_عرض <= 1 ? 0 : (وضع == "سطر" ? (مجموعات.طول <= 1 ? 0 : 0.5) : مركز - 0.5) / (اقصى_عرض - 1) }
      ت = _حد(ت + ازاحة, دوري او ارتداد)
      ناتج.اضف(اساس.طبق(_ف(لون_عند(ح, ت, مساحة, دوري, ارتداد), خلفية), م[0]))
    }
    خارج.اضف(ناتج.ادمج(""))
  }
  ارجع خارج.ادمج("\n")
}
دالة _حد(ت, حر) { ارجع حر ? ت : (ت < 0 ? 0 : (ت > 1 ? 1 : ت)) }

دالة قوس_قزح(ن, خيارات = {}) { ارجع تدرج(ن, "قوس_قزح", خيارات) }
دالة تدرج_خلفية(ن, مصدر, خيارات = {}) {
  خل خ = {}
  خ.دمج(خيارات)
  خ["خلفية"] = صح
  ارجع تدرج(ن, مصدر, خ)
}

// شريط ألوان بعرض معين (كل خانة بلون من التدرج): للعرض والمعاينة
دالة شريط_تدرج(مصدر, عرض = 40, ح = "█", خلفية = غلط) {
  خل ح2 = حلل_مصدر(مصدر)
  خل خ = []
  لكل ي في مدى(0, عرض) {
    خل ل = لون_عند(ح2, عرض == 1 ? 0 : ي / (عرض - 1))
    خ.اضف(خلفية ? اساس.طبق([["b", "r", [ل.r, ل.g, ل.b]]], " ") : اساس.طبق([["f", "r", [ل.r, ل.g, ل.b]]], ح))
  }
  ارجع خ.ادمج("")
}

// نص بلون ثابت من كائن لون/اسم (اختصار)
دالة لون_نص(ل, ن) { ارجع اساس.لون_من(ل, ن) }
