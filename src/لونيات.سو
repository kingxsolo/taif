// لونيات: نواة حسابات الألوان (بلا أي كود طرفية)
// الفضاءات المدعومة: rgb · linear · hsl · hsv · hwb · lab · lch · oklab · oklch
استورد "رياضيات"
استورد "عشوائي"
استورد "./بيانات"

دالة _ثبت(س, ا, ب) { ارجع س < ا ? ا : (س > ب ? ب : س) }
دالة _زاوية(ه) { ارجع ((ه % 360) + 360) % 360 }
دالة _جذر3(س) { ارجع س < 0 ? -رياضيات.قوة(-س, 1 / 3) : رياضيات.قوة(س, 1 / 3) }
دالة _خطي(ق) {
  اذا ق < 0 { ارجع -_خطي(-ق) }
  ارجع ق <= 0.04045 ? ق / 12.92 : رياضيات.قوة((ق + 0.055) / 1.055, 2.4)
}
دالة _غاما(ق) {
  اذا ق < 0 { ارجع -_غاما(-ق) }
  ارجع ق <= 0.0031308 ? ق * 12.92 : 1.055 * رياضيات.قوة(ق, 1 / 2.4) - 0.055
}

// تطبيع الأسماء العربية: همزات وتاء مربوطة وألف مقصورة وتشكيل وتطويل
دالة طبع_عربي(ن) {
  خل خ = []
  لكل ح في نص(ن) {
    خل ر = رمز(ح)
    اذا ر >= 1611 و ر <= 1631 { استمر }
    اذا ر == 1600 او ر == 1648 { استمر }
    اذا ح == "أ" او ح == "إ" او ح == "آ" او ح == "ٱ" { خ.اضف("ا"); استمر }
    اذا ح == "ة" { خ.اضف("ه"); استمر }
    اذا ح == "ى" { خ.اضف("ي"); استمر }
    خ.اضف(ح)
  }
  ارجع خ.ادمج("").نظف().صغير()
}

دالة _نبل(ح) { ارجع "0123456789abcdef".ابحث(ح.صغير()) }
دالة _هيكس_الى_رقم(ز) {
  خل ع = _نبل(ز.جزء(0, 1)); خل ص = _نبل(ز.جزء(1, 2))
  اذا ع < 0 او ص < 0 { ارمي "هيكس غير صالح: ${ز}" }
  ارجع ع * 16 + ص
}
دالة _ر2(ق) { ارجع نسق("{:02x}", رياضيات.قرب(_ثبت(ق, 0, 255))) }

// ---- تحويلات المساحات (تعيد قوائم) ----
دالة _rgb_hsl(ر, غ, ب) {
  ر /= 255; غ /= 255; ب /= 255
  خل ك = رياضيات.اكبر(ر, غ, ب); خل ص = رياضيات.اصغر(ر, غ, ب); خل د = ك - ص
  خل ل = (ك + ص) / 2; خل ه = 0; خل ش = 0
  اذا د > 0 {
    ش = ل > 0.5 ? د / (2 - ك - ص) : د / (ك + ص)
    اذا ك == ر { ه = (غ - ب) / د + (غ < ب ? 6 : 0) }
    والا_اذا ك == غ { ه = (ب - ر) / د + 2 }
    والا { ه = (ر - غ) / د + 4 }
    ه *= 60
  }
  ارجع [ه, ش, ل]
}
دالة _hsl_rgb(ه, ش, ل) {
  ه = _زاوية(ه)
  خل ق = (1 - رياضيات.مطلق(2 * ل - 1)) * ش
  خل س = ق * (1 - رياضيات.مطلق((ه / 60) % 2 - 1))
  خل م = ل - ق / 2
  خل ر = 0; خل غ = 0; خل ب = 0
  اذا ه < 60 { ر = ق; غ = س }
  والا_اذا ه < 120 { ر = س; غ = ق }
  والا_اذا ه < 180 { غ = ق; ب = س }
  والا_اذا ه < 240 { غ = س; ب = ق }
  والا_اذا ه < 300 { ر = س; ب = ق }
  والا { ر = ق; ب = س }
  ارجع [(ر + م) * 255, (غ + م) * 255, (ب + م) * 255]
}
دالة _rgb_hsv(ر, غ, ب) {
  خل ح = _rgb_hsl(ر, غ, ب)
  خل ك = رياضيات.اكبر(ر, غ, ب) / 255; خل ص = رياضيات.اصغر(ر, غ, ب) / 255
  ارجع [ح[0], ك == 0 ? 0 : (ك - ص) / ك, ك]
}
دالة _hsv_rgb(ه, ش, ق) {
  خل ل = ق * (1 - ش / 2)
  خل شل = (ل == 0 او ل == 1) ? 0 : (ق - ل) / رياضيات.اصغر(ل, 1 - ل)
  ارجع _hsl_rgb(ه, شل, ل)
}
دالة _xyz(ر, غ, ب) {
  خل R = _خطي(ر / 255); خل G = _خطي(غ / 255); خل B = _خطي(ب / 255)
  ارجع [0.4124564 * R + 0.3575761 * G + 0.1804375 * B,
        0.2126729 * R + 0.7151522 * G + 0.0721750 * B,
        0.0193339 * R + 0.1191920 * G + 0.9503041 * B]
}
دالة _xyz_rgb(X, Y, Z) {
  ارجع [_غاما(3.2404542 * X - 1.5371385 * Y - 0.4985314 * Z) * 255,
        _غاما(-0.9692660 * X + 1.8760108 * Y + 0.0415560 * Z) * 255,
        _غاما(0.0556434 * X - 0.2040259 * Y + 1.0572252 * Z) * 255]
}
دالة _f_lab(ت) { ارجع ت > 0.008856 ? _جذر3(ت) : 7.787 * ت + 16 / 116 }
دالة _finv_lab(ت) { خل ك = ت * ت * ت; ارجع ك > 0.008856 ? ك : (ت - 16 / 116) / 7.787 }
دالة _rgb_lab(ر, غ, ب) {
  خل ز = _xyz(ر, غ, ب)
  خل fx = _f_lab(ز[0] / 0.95047); خل fy = _f_lab(ز[1]); خل fz = _f_lab(ز[2] / 1.08883)
  ارجع [116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)]
}
دالة _lab_rgb(ل, أ, ب) {
  خل fy = (ل + 16) / 116; خل fx = fy + أ / 500; خل fz = fy - ب / 200
  ارجع _xyz_rgb(_finv_lab(fx) * 0.95047, _finv_lab(fy), _finv_lab(fz) * 1.08883)
}
دالة _قطبي(ل, أ, ب) {
  خل ك = رياضيات.جذر(أ * أ + ب * ب)
  خل ه = ك < 0.0002 ? 0 : _زاوية(رياضيات.ظل2(ب, أ) * 180 / رياضيات.باي)
  ارجع [ل, ك, ه]
}
دالة _ديكارتي(ل, ك, ه) {
  خل ر = ه * رياضيات.باي / 180
  ارجع [ل, ك * رياضيات.جتا(ر), ك * رياضيات.جيب(ر)]
}
دالة _rgb_oklab(ر, غ, ب) {
  خل R = _خطي(ر / 255); خل G = _خطي(غ / 255); خل B = _خطي(ب / 255)
  خل ل = _جذر3(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B)
  خل م = _جذر3(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B)
  خل س = _جذر3(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B)
  ارجع [0.2104542553 * ل + 0.7936177850 * م - 0.0040720468 * س,
        1.9779984951 * ل - 2.4285922050 * م + 0.4505937099 * س,
        0.0259040371 * ل + 0.7827717662 * م - 0.8086757660 * س]
}
دالة _oklab_rgb(ل, أ, ب) {
  خل l1 = ل + 0.3963377774 * أ + 0.2158037573 * ب
  خل m1 = ل - 0.1055613458 * أ - 0.0638541728 * ب
  خل s1 = ل - 0.0894841775 * أ - 1.2914855480 * ب
  خل l3 = l1 * l1 * l1; خل m3 = m1 * m1 * m1; خل s3 = s1 * s1 * s1
  ارجع [_غاما(4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3) * 255,
        _غاما(-1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3) * 255,
        _غاما(-0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3) * 255]
}

// المساحات: الاسم ← (تحويل من rgb، تحويل إلى rgb، فهرس دائرة الألوان أو -1)
دالة _الى(م, ر, غ, ب) {
  اذا م == "rgb" { ارجع [ر, غ, ب] }
  اذا م == "linear" { ارجع [_خطي(ر / 255), _خطي(غ / 255), _خطي(ب / 255)] }
  اذا م == "hsl" { ارجع _rgb_hsl(ر, غ, ب) }
  اذا م == "hsv" { ارجع _rgb_hsv(ر, غ, ب) }
  اذا م == "hwb" { خل ح = _rgb_hsv(ر, غ, ب); ارجع [ح[0], (1 - ح[1]) * ح[2], 1 - ح[2]] }
  اذا م == "lab" { ارجع _rgb_lab(ر, غ, ب) }
  اذا م == "lch" { خل ح = _rgb_lab(ر, غ, ب); ارجع _قطبي(ح[0], ح[1], ح[2]) }
  اذا م == "oklab" { ارجع _rgb_oklab(ر, غ, ب) }
  اذا م == "oklch" { خل ح = _rgb_oklab(ر, غ, ب); ارجع _قطبي(ح[0], ح[1], ح[2]) }
  ارمي "مساحة ألوان غير معروفة: ${م}"
}
دالة _من(م, ق) {
  اذا م == "rgb" { ارجع [ق[0], ق[1], ق[2]] }
  اذا م == "linear" { ارجع [_غاما(ق[0]) * 255, _غاما(ق[1]) * 255, _غاما(ق[2]) * 255] }
  اذا م == "hsl" { ارجع _hsl_rgb(ق[0], ق[1], ق[2]) }
  اذا م == "hsv" { ارجع _hsv_rgb(ق[0], ق[1], ق[2]) }
  اذا م == "hwb" {
    خل ج = ق[1] + ق[2]
    خل ب1 = ج > 1 ? ق[1] / ج : ق[1]; خل س1 = ج > 1 ? ق[2] / ج : ق[2]
    ارجع _hsv_rgb(ق[0], ب1 + س1 >= 1 ? 0 : 1 - ب1 / (1 - س1), 1 - س1)
  }
  اذا م == "lab" { ارجع _lab_rgb(ق[0], ق[1], ق[2]) }
  اذا م == "lch" { خل ح = _ديكارتي(ق[0], ق[1], ق[2]); ارجع _lab_rgb(ح[0], ح[1], ح[2]) }
  اذا م == "oklab" { ارجع _oklab_rgb(ق[0], ق[1], ق[2]) }
  اذا م == "oklch" { خل ح = _ديكارتي(ق[0], ق[1], ق[2]); ارجع _oklab_rgb(ح[0], ح[1], ح[2]) }
  ارمي "مساحة ألوان غير معروفة: ${م}"
}
دالة _فهرس_الدرجة(م) {
  اذا م == "hsl" او م == "hsv" او م == "hwb" { ارجع 0 }
  اذا م == "lch" او م == "oklch" { ارجع 2 }
  ارجع -1
}
// فهرس قناة «الإشباع/الكروما» لتحديد انعدام اللون (الدرجة بلا معنى)
دالة _عديم_اللون(م, ق) {
  اذا م == "hsl" او م == "hsv" { ارجع ق[1] < 0.0001 }
  اذا م == "hwb" { ارجع ق[1] + ق[2] >= 0.9999 }
  ارجع ق[1] < 0.0002
}

// نقطة وسيطة بين قيمتين في مساحة ما (الدرجة بأقصر قوس)
دالة مزج_قوائم(م, أ, ب, ت) {
  خل ف = _فهرس_الدرجة(م)
  خل خ = []
  لكل ي في مدى(0, 3) {
    اذا ي == ف {
      خل ه1 = أ[ي]; خل ه2 = ب[ي]
      اذا _عديم_اللون(م, أ) و ليس _عديم_اللون(م, ب) { ه1 = ه2 }
      والا_اذا _عديم_اللون(م, ب) و ليس _عديم_اللون(م, أ) { ه2 = ه1 }
      خل د = ((ه2 - ه1 + 540) % 360) - 180
      خ.اضف(_زاوية(ه1 + د * ت))
    } والا {
      خ.اضف(أ[ي] + (ب[ي] - أ[ي]) * ت)
    }
  }
  ارجع خ
}

// أوضاع الدمج على قنوات 0..1 (أ = الأساس، ب = الطبقة العليا)
دالة _دمج_قناة(وض, أ, ب) {
  اذا وض == "multiply" او وض == "ضرب" { ارجع أ * ب }
  اذا وض == "screen" او وض == "شاشة" { ارجع 1 - (1 - أ) * (1 - ب) }
  اذا وض == "overlay" او وض == "تراكب" { ارجع أ < 0.5 ? 2 * أ * ب : 1 - 2 * (1 - أ) * (1 - ب) }
  اذا وض == "hardlight" او وض == "ضوء_قوي" { ارجع ب < 0.5 ? 2 * أ * ب : 1 - 2 * (1 - أ) * (1 - ب) }
  اذا وض == "darken" او وض == "اغمق" { ارجع رياضيات.اصغر(أ, ب) }
  اذا وض == "lighten" او وض == "افتح" { ارجع رياضيات.اكبر(أ, ب) }
  اذا وض == "difference" او وض == "فرق" { ارجع رياضيات.مطلق(أ - ب) }
  اذا وض == "exclusion" او وض == "استبعاد" { ارجع أ + ب - 2 * أ * ب }
  اذا وض == "dodge" او وض == "تفتيح_لوني" { ارجع ب >= 1 ? 1 : رياضيات.اصغر(1, أ / (1 - ب)) }
  اذا وض == "burn" او وض == "تعتيم_لوني" { ارجع ب <= 0 ? 0 : 1 - رياضيات.اصغر(1, (1 - أ) / ب) }
  اذا وض == "softlight" او وض == "ضوء_ناعم" {
    اذا ب <= 0.5 { ارجع أ - (1 - 2 * ب) * أ * (1 - أ) }
    خل د = أ <= 0.25 ? ((16 * أ - 12) * أ + 4) * أ : رياضيات.جذر(أ)
    ارجع أ + (2 * ب - 1) * (د - أ)
  }
  ارمي "وضع دمج غير معروف: ${وض}"
}

// تعيين النطاق اللوني: إن خرج اللون عن sRGB نقلّل الكروما في oklch حتى يدخل (بدل القصّ الأعمى)
دالة _خارج(ح) {
  لكل ق في ح { اذا ق < -0.5 او ق > 255.5 { ارجع صح } }
  ارجع غلط
}
دالة _عيّن_النطاق(ح) {
  خل ك = _rgb_oklab(ح[0], ح[1], ح[2])
  اذا ك[0] >= 1 { ارجع [255, 255, 255] }
  اذا ك[0] <= 0 { ارجع [0, 0, 0] }
  خل ق = _قطبي(ك[0], ك[1], ك[2])
  خل ادنى = 0; خل اعلى = ق[1]
  لكل ي في مدى(0, 14) {
    خل وسط = (ادنى + اعلى) / 2
    خل د = _ديكارتي(ق[0], وسط, ق[2])
    اذا _خارج(_oklab_rgb(د[0], د[1], د[2])) { اعلى = وسط } والا { ادنى = وسط }
  }
  خل ن = _ديكارتي(ق[0], ادنى, ق[2])
  ارجع _oklab_rgb(ن[0], ن[1], ن[2])
}

خل _اسماء_مفككة = عدم   // تخزين مؤقت لأسماء CSS للبحث عن الأقرب

صنف لون {
  دالة بناء(ر, غ, ب, ش = 1) {
    هذا.r = _ثبت(ر, 0, 255); هذا.g = _ثبت(غ, 0, 255); هذا.b = _ثبت(ب, 0, 255); هذا.a = _ثبت(ش, 0, 1)
  }

  // ---------- المنشئات ----------
  ساكن دالة من_rgb(ر, غ, ب, ش = 1) { ارجع لون(ر, غ, ب, ش) }
  ساكن دالة من_هيكس(ن) {
    خل ه = نص(ن).نظف()
    ه = ه.يبدأ_ب("#") ? ه.جزء(1) : ه
    خل ط = ه.طول
    اذا ط == 3 او ط == 4 {
      خل خ = []
      لكل ح في ه { خ.اضف(ح + ح) }
      ه = خ.ادمج(""); ط = ه.طول
    }
    اذا ط != 6 و ط != 8 { ارمي "لون هيكس غير صالح: ${ن}" }
    ارجع لون(_هيكس_الى_رقم(ه.جزء(0, 2)), _هيكس_الى_رقم(ه.جزء(2, 4)), _هيكس_الى_رقم(ه.جزء(4, 6)),
             ط == 8 ? _هيكس_الى_رقم(ه.جزء(6, 8)) / 255 : 1)
  }
  ساكن دالة من_مساحة(م, ق, ش = 1) {
    خل ح = _من(م, ق)
    اذا _خارج(ح) { ح = _عيّن_النطاق(ح) }
    ارجع لون(ح[0], ح[1], ح[2], ش)
  }
  ساكن دالة من_hsl(ه, س, ل, ش = 1) { ارجع لون.من_مساحة("hsl", [ه, س, ل], ش) }
  ساكن دالة من_hsv(ه, س, ق, ش = 1) { ارجع لون.من_مساحة("hsv", [ه, س, ق], ش) }
  ساكن دالة من_hwb(ه, وب, سب, ش = 1) { ارجع لون.من_مساحة("hwb", [ه, وب, سب], ش) }
  ساكن دالة من_lab(ل, أ, ب, ش = 1) { ارجع لون.من_مساحة("lab", [ل, أ, ب], ش) }
  ساكن دالة من_lch(ل, ك, ه, ش = 1) { ارجع لون.من_مساحة("lch", [ل, ك, ه], ش) }
  ساكن دالة من_oklab(ل, أ, ب, ش = 1) { ارجع لون.من_مساحة("oklab", [ل, أ, ب], ش) }
  ساكن دالة من_oklch(ل, ك, ه, ش = 1) { ارجع لون.من_مساحة("oklch", [ل, ك, ه], ش) }
  ساكن دالة من_cmyk(ج, م, ص, ك, ش = 1) {
    ارجع لون(255 * (1 - ج) * (1 - ك), 255 * (1 - م) * (1 - ك), 255 * (1 - ص) * (1 - ك), ش)
  }
  ساكن دالة من_درجة_حرارة(كلفن) {
    // تقريب شائع للون الجسم الأسود (1000K - 40000K)
    خل ت = _ثبت(كلفن, 1000, 40000) / 100
    خل ر = ت <= 66 ? 255 : 329.698727446 * رياضيات.قوة(ت - 60, -0.1332047592)
    خل غ = ت <= 66 ? 99.4708025861 * رياضيات.لوغ(ت) - 161.1195681661 : 288.1221695283 * رياضيات.قوة(ت - 60, -0.0755148492)
    خل ب = ت >= 66 ? 255 : (ت <= 19 ? 0 : 138.5177312231 * رياضيات.لوغ(ت - 10) - 305.0447927307)
    ارجع لون(ر, غ, ب)
  }
  ساكن دالة عشوائي_لون() { ارجع لون(عشوائي.صحيح(0, 255), عشوائي.صحيح(0, 255), عشوائي.صحيح(0, 255)) }
  ساكن دالة عشوائي_جميل() { ارجع لون.من_oklch(0.75, 0.13, عشوائي.رقم() * 360) }

  // تحليل نص: هيكس، rgb()/rgba()، hsl()/hsla()، اسم CSS، اسم عربي
  ساكن دالة من_نص(ن) {
    اذا نوع(ن) != "نص" { ارمي "من_نص يتوقع نصاً" }
    خل ك = ن.نظف().صغير()
    اذا ك.يبدأ_ب("#") { ارجع لون.من_هيكس(ك) }
    خل ف = ك.ابحث("(")
    اذا ف > 0 و ك.ينتهي_ب(")") {
      خل اسم = ك.جزء(0, ف).نظف()
      خل اجزاء = ك.جزء(ف + 1, ك.طول - 1).ابدل("/", " ").ابدل(",", " ").قسم()
      اذا اجزاء.طول < 3 { ارمي "لون غير صالح: ${ن}" }
      خل ق = []
      لكل ج في اجزاء {
        خل ص = ج.ينتهي_ب("%")
        خل ر = رقم(ص ? ج.جزء(0, ج.طول - 1) : ج.ابدل("deg", ""))
        اذا ر == عدم { ارمي "لون غير صالح: ${ن}" }
        ق.اضف(ص ? ر / 100 : ر)
      }
      خل ش = 1
      اذا اجزاء.طول > 3 { ش = ق[3] }
      اذا اسم == "rgb" او اسم == "rgba" {
        خل خ = []
        لكل ي في مدى(0, 3) { خ.اضف(اجزاء[ي].ينتهي_ب("%") ? ق[ي] * 255 : ق[ي]) }
        ارجع لون(خ[0], خ[1], خ[2], ش)
      }
      اذا اسم == "hsl" او اسم == "hsla" { ارجع لون.من_hsl(ق[0], اجزاء[1].ينتهي_ب("%") ? ق[1] : ق[1] / 100, اجزاء[2].ينتهي_ب("%") ? ق[2] : ق[2] / 100, ش) }
      اذا اسم == "hwb" { ارجع لون.من_hwb(ق[0], ق[1], ق[2], ش) }
      اذا اسم == "oklch" { ارجع لون.من_oklch(ق[0], ق[1], ق[2], ش) }
      اذا اسم == "lch" { ارجع لون.من_lch(ق[0], ق[1], ق[2], ش) }
      ارمي "صيغة لون غير معروفة: ${اسم}"
    }
    خل ع = بيانات.اسماء_css.احصل(ك)
    اذا ع != عدم { ارجع لون.من_هيكس(ع) }
    خل ط = طبع_عربي(ن).ابدل(" ", "_")
    ع = بيانات.اسماء_عربية.احصل(ط)
    اذا ع != عدم { ارجع لون.من_هيكس(ع) }
    ارمي "لون غير معروف: ${ن}"
  }

  // ---------- التصدير ----------
  دالة rgb() { ارجع [رياضيات.قرب(هذا.r), رياضيات.قرب(هذا.g), رياضيات.قرب(هذا.b)] }
  دالة هيكس(بشفافية = غلط) {
    خل ن = "#" + _ر2(هذا.r) + _ر2(هذا.g) + _ر2(هذا.b)
    اذا هذا.a < 1 او بشفافية { ن += _ر2(هذا.a * 255) }
    ارجع ن
  }
  دالة الى(م) { ارجع _الى(م, هذا.r, هذا.g, هذا.b) }
  دالة hsl() { ارجع _rgb_hsl(هذا.r, هذا.g, هذا.b) }
  دالة hsv() { ارجع _rgb_hsv(هذا.r, هذا.g, هذا.b) }
  دالة hwb() { ارجع _الى("hwb", هذا.r, هذا.g, هذا.b) }
  دالة lab() { ارجع _rgb_lab(هذا.r, هذا.g, هذا.b) }
  دالة lch() { ارجع _الى("lch", هذا.r, هذا.g, هذا.b) }
  دالة oklab() { ارجع _rgb_oklab(هذا.r, هذا.g, هذا.b) }
  دالة oklch() { ارجع _الى("oklch", هذا.r, هذا.g, هذا.b) }
  دالة cmyk() {
    خل ك = 1 - رياضيات.اكبر(هذا.r, هذا.g, هذا.b) / 255
    اذا ك >= 1 { ارجع [0, 0, 0, 1] }
    ارجع [(1 - هذا.r / 255 - ك) / (1 - ك), (1 - هذا.g / 255 - ك) / (1 - ك), (1 - هذا.b / 255 - ك) / (1 - ك), ك]
  }
  دالة css(صيغة = "hex") {
    اذا صيغة == "rgb" {
      خل ر = هذا.rgb()
      ارجع هذا.a < 1 ? "rgba(${ر[0]}, ${ر[1]}, ${ر[2]}, ${رياضيات.قرب(هذا.a * 100) / 100})" : "rgb(${ر[0]}, ${ر[1]}, ${ر[2]})"
    }
    اذا صيغة == "hsl" {
      خل ح = هذا.hsl()
      ارجع "hsl(${رياضيات.قرب(ح[0])}, ${رياضيات.قرب(ح[1] * 100)}%, ${رياضيات.قرب(ح[2] * 100)}%)"
    }
    اذا صيغة == "oklch" {
      خل ح = هذا.oklch()
      ارجع "oklch(${رياضيات.قرب(ح[0] * 1000) / 1000} ${رياضيات.قرب(ح[1] * 1000) / 1000} ${رياضيات.قرب(ح[2] * 10) / 10})"
    }
    ارجع هذا.هيكس()
  }
  دالة نص() { ارجع هذا.هيكس() }

  // ---------- الخصائص البصرية ----------
  دالة لمعان() {
    ارجع 0.2126 * _خطي(هذا.r / 255) + 0.7152 * _خطي(هذا.g / 255) + 0.0722 * _خطي(هذا.b / 255)
  }
  دالة تباين(آخر) {
    خل أ = هذا.لمعان() + 0.05; خل ب = آخر.لمعان() + 0.05
    ارجع أ > ب ? أ / ب : ب / أ
  }
  دالة هل_فاتح() { ارجع هذا.oklab()[0] > 0.6 }
  دالة نص_مناسب(فاتح = عدم, غامق = عدم) {
    خل ب = فاتح ?? لون(255, 255, 255); خل د = غامق ?? لون(0, 0, 0)
    ارجع هذا.تباين(ب) >= هذا.تباين(د) ? ب : د
  }
  // يعدّل لون النص (هذا) تدريجياً حتى يبلغ تبايناً كافياً (WCAG AA = 4.5) على خلفية معينة
  دالة اجعل_مقروءا(خلفية, حد = 4.5) {
    اذا هذا.تباين(خلفية) >= حد { ارجع هذا }
    خل ح = هذا.oklch()
    خل نحو_ابيض = خلفية.لمعان() < 0.18
    خل ل = ح[0]
    خل ي = 0
    طالما ي < 100 {
      ل += نحو_ابيض ? 0.01 : -0.01
      خل ج = لون.من_oklch(_ثبت(ل, 0, 1), ح[1], ح[2])
      اذا ج.تباين(خلفية) >= حد او ل <= 0 او ل >= 1 { ارجع ج }
      ي += 1
    }
    ارجع هذا.نص_مناسب()
  }
  // فرق الألوان: «oklab» (افتراضي، إدراكي) أو «lab» (CIE76)
  دالة فرق(آخر, م = "oklab") {
    خل أ = هذا.الى(م); خل ب = آخر.الى(م)
    خل ك = م == "oklab" ? 100 : 1
    ارجع رياضيات.جذر((أ[0] - ب[0]) ** 2 + (أ[1] - ب[1]) ** 2 + (أ[2] - ب[2]) ** 2) * ك
  }
  دالة اقرب_اسم() {
    اذا _اسماء_مفككة == عدم {
      _اسماء_مفككة = []
      لكل ن, ه في بيانات.اسماء_css { _اسماء_مفككة.اضف([ن, لون.من_هيكس(ه)]) }
    }
    خل افضل = عدم; خل مسافة = 1e9
    لكل ز في _اسماء_مفككة {
      خل د = هذا.فرق(ز[1])
      اذا د < مسافة { مسافة = د; افضل = ز[0] }
    }
    ارجع افضل
  }

  // ---------- التعديل (كل دالة تعيد لوناً جديداً) ----------
  دالة شفافية(ش) { ارجع لون(هذا.r, هذا.g, هذا.b, ش) }
  دالة عدل(م, ف, قيمة, نسبي = غلط) {
    خل ق = هذا.الى(م)
    ق[ف] = نسبي ? ق[ف] + قيمة : قيمة
    ارجع لون.من_مساحة(م, ق, هذا.a)
  }
  دالة افتح(ك = 0.1) { خل ح = هذا.hsl(); ارجع لون.من_hsl(ح[0], ح[1], _ثبت(ح[2] + ك, 0, 1), هذا.a) }
  دالة اغمق(ك = 0.1) { ارجع هذا.افتح(-ك) }
  دالة اشبع(ك = 0.1) { خل ح = هذا.hsl(); ارجع لون.من_hsl(ح[0], _ثبت(ح[1] + ك, 0, 1), ح[2], هذا.a) }
  دالة اضعف(ك = 0.1) { ارجع هذا.اشبع(-ك) }
  دالة لف(درجات) { خل ح = هذا.hsl(); ارجع لون.من_hsl(ح[0] + درجات, ح[1], ح[2], هذا.a) }
  دالة رمادي() { خل ل = هذا.لمعان(); خل ق = _غاما(ل) * 255; ارجع لون(ق, ق, ق, هذا.a) }
  دالة اعكس() { ارجع لون(255 - هذا.r, 255 - هذا.g, 255 - هذا.b, هذا.a) }
  دالة مكمل() { ارجع هذا.لف(180) }
  // يمزج مع لون آخر: ت = نسبة اللون الآخر (0..1)، م = المساحة (الافتراضي oklab لنتائج أنعم)
  دالة امزج(آخر, ت = 0.5, م = "oklab") {
    خل ق = مزج_قوائم(م, هذا.الى(م), آخر.الى(م), ت)
    ارجع لون.من_مساحة(م, ق, هذا.a + (آخر.a - هذا.a) * ت)
  }
  دالة ابيض_اكثر(ت = 0.2) { ارجع هذا.امزج(لون(255, 255, 255), ت) }
  دالة اسود_اكثر(ت = 0.2) { ارجع هذا.امزج(لون(0, 0, 0), ت) }
  // دمج بأوضاع الطبقات: هذا = الأساس، آخر = الطبقة العليا
  دالة دمج_وضع(آخر, وض) {
    خل أ = [هذا.r / 255, هذا.g / 255, هذا.b / 255]; خل ب = [آخر.r / 255, آخر.g / 255, آخر.b / 255]
    ارجع لون(_دمج_قناة(وض, أ[0], ب[0]) * 255, _دمج_قناة(وض, أ[1], ب[1]) * 255, _دمج_قناة(وض, أ[2], ب[2]) * 255, هذا.a)
  }
  // يركّب اللون الشفاف فوق خلفية معتمة
  دالة ركب(خلفية) {
    خل ش = هذا.a
    ارجع لون(هذا.r * ش + خلفية.r * (1 - ش), هذا.g * ش + خلفية.g * (1 - ش), هذا.b * ش + خلفية.b * (1 - ش))
  }

  // ---------- التناسق اللوني ----------
  دالة تناسق(نوع_) {
    اذا نوع_ == "مكمل" او نوع_ == "complementary" { ارجع [هذا, هذا.لف(180)] }
    اذا نوع_ == "ثلاثي" او نوع_ == "triad" { ارجع [هذا, هذا.لف(120), هذا.لف(240)] }
    اذا نوع_ == "رباعي" او نوع_ == "tetrad" { ارجع [هذا, هذا.لف(90), هذا.لف(180), هذا.لف(270)] }
    اذا نوع_ == "مجاور" او نوع_ == "analogous" { ارجع [هذا.لف(-30), هذا, هذا.لف(30)] }
    اذا نوع_ == "مكمل_منقسم" او نوع_ == "split" { ارجع [هذا, هذا.لف(150), هذا.لف(210)] }
    اذا نوع_ == "مربع" او نوع_ == "square" { ارجع [هذا, هذا.لف(90), هذا.لف(180), هذا.لف(270)] }
    ارمي "نوع تناسق غير معروف: ${نوع_}"
  }
  // درجات من الفاتح إلى الغامق تمر بهذا اللون في المنتصف
  دالة درجات(ن = 9) {
    خل خ = []
    خل ق = ن - 1
    لكل ي في مدى(0, ن) {
      خل ت = ي / ق * 2 - 1
      خ.اضف(ت < 0 ? هذا.امزج(لون(255, 255, 255), -ت * 0.92) : هذا.امزج(لون(0, 0, 0), ت * 0.85))
    }
    ارجع خ
  }
}

// مزج عدة محطات: stops قائمة ألوان (كائنات لون)، ت بين 0 و1، مواضع اختيارية
دالة عند(محطات, ت, م = "oklab", مواضع = عدم) {
  خل ن = محطات.طول
  اذا ن == 1 { ارجع محطات[0] }
  ت = _ثبت(ت, 0, 1)
  خل م2 = مواضع ?? []
  اذا م2.طول != ن {
    م2 = []
    لكل ي في مدى(0, ن) { م2.اضف(ي / (ن - 1)) }
  }
  لكل ي في مدى(0, ن - 1) {
    اذا ت <= م2[ي + 1] او ي == ن - 2 {
      خل ع = م2[ي + 1] - م2[ي]
      خل ل = ع <= 0 ? 1 : _ثبت((ت - م2[ي]) / ع, 0, 1)
      ارجع محطات[ي].امزج(محطات[ي + 1], ل, م)
    }
  }
  ارجع محطات[ن - 1]
}
