// معاينة: عرض الألوان واللوحات وتشخيص الطرفية
استورد "نظام"
استورد "رياضيات"
استورد "./اساس"
استورد "./لونيات"
استورد "./تدرج"
استورد "./واجهة"
استورد "./بيانات"

دالة _ك(ل) { ارجع نوع(ل) == "نص" ? لونيات.لون.من_نص(ل) : ل }
دالة _خلفية(ل, ن) { خل ك = _ك(ل); ارجع اساس.طبق([["b", "r", [ك.r, ك.g, ك.b]]], ن) }
دالة _ر(ق, د = 1) { ارجع نسق("{:.${د}f}", ق) }

// صف مربعات ملونة والهيكس تحتها. خيارات: {عرض_خلية, ارتفاع, تسميات}
دالة لوحة(الوان, خيارات = {}) {
  خل ع = خيارات.احصل("عرض_خلية", 9); خل ارتفاع = خيارات.احصل("ارتفاع", 1)
  خل صفوف = []
  لكل ي في مدى(0, ارتفاع) {
    خل س = []
    لكل ل في الوان { س.اضف(_خلفية(ل, " " * ع)) }
    صفوف.اضف(س.ادمج(""))
  }
  اذا خيارات.احصل("تسميات", صح) {
    خل ت = []
    لكل ل في الوان { ت.اضف(اساس.املأ(_ك(ل).هيكس(), ع, "وسط")) }
    صفوف.اضف(ت.ادمج(""))
  }
  ارجع صفوف.ادمج("\n")
}

دالة _حكم(ن) { ارجع ن >= 7 ? "AAA ✔" : (ن >= 4.5 ? "AA ✔" : (ن >= 3 ? "نص كبير فقط" : "ضعيف ✖")) }

// بطاقة معلومات عن لون: القيم في كل الفضاءات، التباين، أقرب اسم
دالة معاينة(ل) {
  خل ك = _ك(ل)
  خل ر = ك.rgb(); خل ح = ك.hsl(); خل ا = ك.oklch(); خل م = ك.cmyk(); خل ل3 = ك.lab()
  خل ابيض = ك.تباين(لونيات.لون(255, 255, 255)); خل اسود = ك.تباين(لونيات.لون(0, 0, 0))
  خل سطور = [_خلفية(ك, " " * 30), _خلفية(ك, " " * 30)]
  سطور.اضف("HEX    ${ك.هيكس()}")
  سطور.اضف("RGB    ${ر[0]}, ${ر[1]}, ${ر[2]}")
  سطور.اضف("HSL    ${رياضيات.قرب(ح[0])}°  ${رياضيات.قرب(ح[1] * 100)}%  ${رياضيات.قرب(ح[2] * 100)}%")
  سطور.اضف("OKLCH  ${_ر(ا[0], 3)}  ${_ر(ا[1], 3)}  ${_ر(ا[2], 0)}°")
  سطور.اضف("LAB    ${_ر(ل3[0])}  ${_ر(ل3[1])}  ${_ر(ل3[2])}")
  سطور.اضف("CMYK   ${رياضيات.قرب(م[0] * 100)}%  ${رياضيات.قرب(م[1] * 100)}%  ${رياضيات.قرب(م[2] * 100)}%  ${رياضيات.قرب(م[3] * 100)}%")
  سطور.اضف("")
  سطور.اضف("تباين مع الأبيض  ${_ر(ابيض, 2)}:1  ${_حكم(ابيض)}")
  سطور.اضف("تباين مع الأسود  ${_ر(اسود, 2)}:1  ${_حكم(اسود)}")
  سطور.اضف("أقرب اسم CSS    ${ك.اقرب_اسم()}")
  ارجع واجهة.اطار(سطور.ادمج("\n"), {"نمط": "مدور", "عنوان": ك.هيكس(), "لون_الاطار": ك.هيكس()})
}

// شريط ألوان الطيف الكامل
دالة طيف_كامل(عرض = 60) {
  خل خ = []
  لكل ي في مدى(0, عرض) { خ.اضف(_خلفية(لونيات.لون.من_hsl(ي / عرض * 360, 1, 0.5), " ")) }
  ارجع خ.ادمج("")
}

// لوحة الـ256 لوناً
دالة عرض_256() {
  خل صفوف = []
  لكل ص في مدى(0, 16) {
    خل س = []
    لكل ع في مدى(0, 16) {
      خل ن = ص * 16 + ع
      خل ل = اساس.ansi256_الى_rgb(ن)
      خل نص_ = لونيات.لون(ل[0], ل[1], ل[2]).نص_مناسب()
      س.اضف(اساس.طبق([["b", "x", ن], ["f", "r", [نص_.r, نص_.g, نص_.b]]], اساس.املأ(نص(ن), 4, "وسط")))
    }
    صفوف.اضف(س.ادمج(""))
  }
  ارجع صفوف.ادمج("\n")
}

// يعرض التدرج نفسه بمستويات الطرفية الثلاثة ليظهر أثر التخفيض التلقائي
دالة قارن_المستويات(مصدر = "قوس_قزح", عرض = 48) {
  خل اصلي = اساس.مستوى()
  اذا اصلي == 0 { ارجع "(الطرفية الحالية بلا ألوان؛ جرّب FORCE_COLOR=3)" }
  خل خ = []
  لكل م في [3, 2, 1] {
    اساس.ضبط_المستوى(م)
    خل ن = م == 3 ? "24 بت " : (م == 2 ? "256   " : "16    ")
    خ.اضف(ن + " " + تدرج.شريط_تدرج(مصدر, عرض, " ", صح))
  }
  اساس.ضبط_المستوى(اصلي)
  ارجع خ.ادمج("\n")
}

// تقرير عن قدرات الطرفية الحالية
دالة تشخيص() {
  خل بيئة = دالة(ن) { ارجع اساس.قراءة_بيئة(ن) ?? "-" }
  خل اسماء = ["لا ألوان", "16 لوناً", "256 لوناً", "ألوان حقيقية (24 بت)"]
  خل سطور = [
    "مستوى الألوان   ${اساس.مستوى()}  (${اسماء[اساس.مستوى()]})",
    "طرفية حية       ${اساس.طرفية_حية() ? "نعم" : "لا"}",
    "العرض           ${اساس.عرض_الطرفية()}",
    "TERM            ${بيئة("TERM")}",
    "COLORTERM       ${بيئة("COLORTERM")}",
    "NO_COLOR        ${بيئة("NO_COLOR")}",
    "FORCE_COLOR     ${بيئة("FORCE_COLOR")}",
    "رموز عريضة      ${اساس.طول_مرئي("😀")} خانة (المتوقع 2)",
    "عربي مشكّل      ${اساس.طول_مرئي("عَرَبِيّ")} خانة (المتوقع 4)"
  ]
  ارجع واجهة.اطار(سطور.ادمج("\n"), {"نمط": "مدور", "عنوان": "تشخيص طيف"})
}
