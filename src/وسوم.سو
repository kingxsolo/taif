// وسوم: لغة وسوم بين أقواس مربعة للتلوين داخل النص، مثل Rich
//   "[احمر غامق]خطأ[/] عادي [#ff8800 مسطر]برتقالي[/] [تدرج:غروب]نص بتدرج[/]"
// «[[» تعني قوس مربع حرفياً. وكل ما بين الأقواس ولا يُفهم نمطاً يبقى كما هو.
استورد "./اساس"
استورد "./تدرج"
استورد "./لونيات"

دالة _صالح(مواصفة) {
  خل م = مواصفة.نظف()
  اذا م == "" { ارجع غلط }
  اذا م.يبدأ_ب("تدرج:") او م.يبدأ_ب("gradient:") {
    خل مصدر = م.جزء(م.ابحث(":") + 1).نظف()
    حاول { تدرج.حلل_مصدر(مصدر.يحتوي(",") ? مصدر.قسم(",").حول(ن => ن.نظف()) : مصدر); ارجع صح } امسك (خ) { ارجع غلط }
  }
  ارجع اساس.حلل_نمط(م) != عدم
}

دالة _ارسم(مقطع) {
  خل ن = مقطع[0]
  خل ك = مقطع[1]
  اذا ك.طول == 0 { ارجع ن }
  خل عادية = []; خل مصدر = عدم
  لكل م في ك {
    اذا م.يبدأ_ب("تدرج:") او م.يبدأ_ب("gradient:") {
      خل ز = م.جزء(م.ابحث(":") + 1).نظف()
      مصدر = ز.يحتوي(",") ? ز.قسم(",").حول(ن2 => ن2.نظف()) : ز
    } والا { عادية.اضف(م) }
  }
  خل ناتج = ن
  اذا مصدر != عدم { ناتج = تدرج.تدرج(ناتج, مصدر, {"وضع": "كلمة"}) }
  اذا عادية.طول > 0 { ناتج = اساس.نمط(...عادية)(ناتج) }
  ارجع ناتج
}

// يحوّل نصاً فيه وسوم إلى نص ملوّن
دالة وسوم(ن) {
  خل ح = نص(ن).حروف()
  خل ط = ح.طول
  خل مقاطع = []; خل مكدس = []; خل حالي = []
  خل افرغ = دالة() {
    اذا حالي.طول > 0 { مقاطع.اضف([حالي.ادمج(""), مكدس.انسخ()]); حالي.امسح() }
  }
  خل ي = 0
  طالما ي < ط {
    خل ك = ح[ي]
    اذا ك == "]" و ي + 1 < ط و ح[ي + 1] == "]" { حالي.اضف("]"); ي += 2; استمر }
    اذا ك == "[" {
      اذا ي + 1 < ط و ح[ي + 1] == "[" { حالي.اضف("["); ي += 2; استمر }
      خل ج = ي + 1
      طالما ج < ط و ح[ج] != "]" و ح[ج] != "[" { ج += 1 }
      اذا ج < ط و ح[ج] == "]" {
        خل داخل = ح.جزء(ي + 1, ج).ادمج("")
        اذا داخل == "/" او (داخل.يبدأ_ب("/") و داخل.طول > 1 و ليس _صالح(داخل)) {
          افرغ()
          اذا مكدس.طول > 0 { مكدس.اسحب() }
          ي = ج + 1; استمر
        }
        اذا _صالح(داخل) {
          افرغ()
          مكدس.اضف(داخل.نظف())
          ي = ج + 1; استمر
        }
      }
    }
    حالي.اضف(ك)
    ي += 1
  }
  افرغ()
  خل خ = []
  لكل م في مقاطع { خ.اضف(_ارسم(م)) }
  ارجع خ.ادمج("")
}
// يحذف الوسوم ويعيد النص العادي
دالة الغ_الوسوم(ن) {
  خل ملون = وسوم(ن)
  ارجع اساس.ازل(ملون)
}
// يهرب الأقواس المربعة كي لا تُفهم وسوماً
دالة اهرب(ن) { ارجع نص(ن).ابدل("[", "[[") }
