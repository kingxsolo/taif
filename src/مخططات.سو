// مخططات: رسوم بيانية نصية ملوّنة: أعمدة، خط صغير، خريطة حرارية، تكديس، ومخطط خطي
استورد "رياضيات"
استورد "./اساس"
استورد "./تدرج"
استورد "./لونيات"
استورد "./واجهة"
استورد "./بيانات"

// يقبل قاموساً {تسمية: قيمة} أو قائمة أزواج [[تسمية، قيمة]...] ويعيد قائمة أزواج
دالة _ازواج(ب) {
  اذا نوع(ب) == "قاموس" { ارجع ب.ازواج() }
  ارجع ب
}

// مخطط أعمدة أفقي. خيارات: {عرض, تدرج, لون, لون_بالقيمة, اظهر_القيم, عنوان, اقصى, وحدة, نمط}
دالة مخطط_اعمدة(بيانات_, خيارات = {}) {
  خل ز = _ازواج(بيانات_)
  اذا ز.طول == 0 { ارجع "" }
  خل عرض = خيارات.احصل("عرض", 30); خل وحدة = خيارات.احصل("وحدة", "")
  خل مصدر = خيارات.احصل("تدرج", عدم); خل بالقيمة = خيارات.احصل("لون_بالقيمة", غلط)
  خل اظهر = خيارات.احصل("اظهر_القيم", صح)
  خل اقصى = خيارات.احصل("اقصى", عدم)
  اذا اقصى == عدم { اقصى = 0; لكل ج في ز { اذا ج[1] > اقصى { اقصى = ج[1] } } }
  اذا اقصى <= 0 { اقصى = 1 }
  خل عرض_تسمية = 0
  لكل ج في ز { عرض_تسمية = رياضيات.اكبر(عرض_تسمية, اساس.طول_مرئي(نص(ج[0]))) }
  خل نصوص_قيم = ز.حول(ج => نص(ج[1]) + وحدة)
  خل عرض_قيمة = 0
  لكل ن في نصوص_قيم { عرض_قيمة = رياضيات.اكبر(عرض_قيمة, اساس.طول_مرئي(ن)) }
  خل خارج = []
  اذا خيارات.احصل("عنوان", "") != "" { خارج.اضف(اساس.غامق(خيارات["عنوان"])) }
  لكل ي, ج في ز {
    خل نسبة = ج[1] / اقصى
    خل خ = {"نمط": خيارات.احصل("نمط", "ناعم")}
    اذا بالقيمة و مصدر != عدم { خ["لون"] = تدرج.لون_عند(مصدر, نسبة).هيكس() }
    والا_اذا مصدر != عدم { خ["تدرج"] = مصدر }
    والا { خ["لون"] = خيارات.احصل("لون", "اخضر") }
    خل شريط_ = واجهة.شريط_نسبة(نسبة, عرض, خ)
    خل سطر = اساس.املأ(نص(ج[0]), عرض_تسمية, "يسار") + " " + اساس.خافت("│") + " " + شريط_
    اذا اظهر { سطر += " " + اساس.املأ(نصوص_قيم[ي], عرض_قيمة, "يمين") }
    خارج.اضف(سطر)
  }
  ارجع خارج.ادمج("\n")
}

// خط صغير ▁▂▃▄▅▆▇█ لسلسلة أرقام (اختيارياً ملوّن بتدرج حسب القيمة)
دالة خط_صغير(قائمة_, مصدر = عدم) {
  خل ح = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  اذا قائمة_.طول == 0 { ارجع "" }
  خل ص = رياضيات.اصغر(...قائمة_); خل ك = رياضيات.اكبر(...قائمة_)
  خل خ = []
  لكل ق في قائمة_ {
    خل ت = ك == ص ? 0.5 : (ق - ص) / (ك - ص)
    خل رمز_ = ح[رياضيات.اصغر(7, رياضيات.بتر(ت * 8))]
    خ.اضف(مصدر == عدم ? رمز_ : اساس.لون_من(تدرج.لون_عند(مصدر, ت), رمز_))
  }
  ارجع خ.ادمج("")
}

// خريطة حرارية لمصفوفة أرقام. خيارات: {تدرج, قيم, تسميات_صفوف, تسميات_اعمدة, عرض_خلية, عنوان}
دالة خريطة_حرارية(مصفوفة, خيارات = {}) {
  خل مصدر = خيارات.احصل("تدرج", "حرارة"); خل ع = خيارات.احصل("عرض_خلية", خيارات.احصل("قيم", غلط) ? 5 : 2)
  خل ص = 1e18; خل ك = -1e18
  لكل س في مصفوفة { لكل ق في س { اذا ق < ص { ص = ق }; اذا ق > ك { ك = ق } } }
  خل ص_تسميات = خيارات.احصل("تسميات_صفوف", عدم); خل ع_تسميات = خيارات.احصل("تسميات_اعمدة", عدم)
  خل عرض_ت = 0
  اذا ص_تسميات != عدم { لكل ن في ص_تسميات { عرض_ت = رياضيات.اكبر(عرض_ت, اساس.طول_مرئي(نص(ن))) } }
  خل خارج = []
  اذا خيارات.احصل("عنوان", "") != "" { خارج.اضف(اساس.غامق(خيارات["عنوان"])) }
  اذا ع_تسميات != عدم {
    خل راس = " " * (عرض_ت > 0 ? عرض_ت + 1 : 0)
    لكل ن في ع_تسميات { راس += اساس.املأ(نص(ن), ع, "وسط") }
    خارج.اضف(راس)
  }
  لكل ر, س في مصفوفة {
    خل سطر = ص_تسميات != عدم ? اساس.املأ(نص(ص_تسميات[ر]), عرض_ت) + " " : ""
    لكل ق في س {
      خل ت = ك == ص ? 0.5 : (ق - ص) / (ك - ص)
      خل ل = تدرج.لون_عند(مصدر, ت)
      خل محتوى = خيارات.احصل("قيم", غلط) ? اساس.املأ(نص(ق), ع, "وسط") : " " * ع
      سطر += اساس.طبق([["f", "r", [ل.نص_مناسب().r, ل.نص_مناسب().g, ل.نص_مناسب().b]], ["b", "r", [ل.r, ل.g, ل.b]]], محتوى)
    }
    خارج.اضف(سطر)
  }
  ارجع خارج.ادمج("\n")
}

// شريط مقسّم بنسب القيم مع مفتاح. بيانات: {تسمية: قيمة}. خيارات: {عرض, الوان}
دالة مخطط_تكديس(بيانات_, خيارات = {}) {
  خل ز = _ازواج(بيانات_)
  خل عرض = خيارات.احصل("عرض", 40)
  خل الوان = خيارات.احصل("الوان", ["#3b82f6", "#22c55e", "#f59e0b", "#ef4444", "#a855f7", "#06b6d4", "#ec4899", "#84cc16"])
  خل مجموع = 0
  لكل ج في ز { مجموع += ج[1] }
  اذا مجموع <= 0 { ارجع "" }
  خل شريط_ = ""; خل مستعمل = 0; خل مفتاح = []
  لكل ي, ج في ز {
    خل ل = لونيات.لون.من_نص(الوان[ي % الوان.طول])
    خل حد = ي == ز.طول - 1 ? عرض - مستعمل : رياضيات.قرب(ج[1] / مجموع * عرض)
    اذا حد < 0 { حد = 0 }
    مستعمل += حد
    شريط_ += اساس.لون_من(ل, "█" * حد)
    مفتاح.اضف(اساس.لون_من(ل, "■") + " ${ج[0]} " + اساس.خافت(نسق("{:.1f}", ج[1] / مجموع * 100) + "%"))
  }
  ارجع شريط_ + "\n" + مفتاح.ادمج("  ")
}

// مخطط خطي (مثل asciichart): خيارات {ارتفاع, تدرج, عرض_تسمية}
دالة مخطط_خطي(سلسلة, خيارات = {}) {
  اذا سلسلة.طول == 0 { ارجع "" }
  خل ارتفاع = خيارات.احصل("ارتفاع", 8); خل مصدر = خيارات.احصل("تدرج", عدم)
  خل ص = رياضيات.اصغر(...سلسلة); خل ك = رياضيات.اكبر(...سلسلة)
  خل مدى_ = ك - ص
  خل نسبة = مدى_ == 0 ? 1 : ارتفاع / مدى_
  خل ص2 = رياضيات.ارضي(ص * نسبة); خل ك2 = رياضيات.سقف(ك * نسبة)
  خل صفوف = ك2 - ص2
  خل تسميات = []
  لكل ي في مدى(0, صفوف + 1) {
    خل ق = ك - ي * مدى_ / (صفوف == 0 ? 1 : صفوف)
    تسميات.اضف(نسق("{:.2f}", ق))
  }
  خل عرض_ت = 0
  لكل ن في تسميات { عرض_ت = رياضيات.اكبر(عرض_ت, ن.طول) }
  خل ازاحة = عرض_ت + 2
  خل شبكة = []
  لكل ي في مدى(0, صفوف + 1) {
    خل س = []
    لكل ج في مدى(0, سلسلة.طول + ازاحة) { س.اضف(" ") }
    شبكة.اضف(س)
  }
  لكل ي في مدى(0, صفوف + 1) {
    خل ن = تسميات[ي]
    لكل ج, ح في ن.حروف() { شبكة[ي][ازاحة - 2 - ن.طول + ج + 1] = ح }
    شبكة[ي][ازاحة - 1] = (ك2 - ي) == 0 ? "┼" : "┤"
  }
  خل ص0 = رياضيات.قرب(سلسلة[0] * نسبة) - ص2
  شبكة[صفوف - ص0][ازاحة - 1] = "┼"
  لكل س في مدى(0, سلسلة.طول - 1) {
    خل أ = رياضيات.قرب(سلسلة[س] * نسبة) - ص2
    خل ب = رياضيات.قرب(سلسلة[س + 1] * نسبة) - ص2
    اذا أ == ب { شبكة[صفوف - أ][س + ازاحة] = "─" }
    والا {
      شبكة[صفوف - ب][س + ازاحة] = أ > ب ? "╰" : "╭"
      شبكة[صفوف - أ][س + ازاحة] = أ > ب ? "╮" : "╯"
      لكل ي في مدى(رياضيات.اصغر(أ, ب) + 1, رياضيات.اكبر(أ, ب)) { شبكة[صفوف - ي][س + ازاحة] = "│" }
    }
  }
  خل خارج = []
  لكل ي, س في شبكة {
    خل ت = صفوف == 0 ? 0 : 1 - ي / صفوف
    خل ك_ = س.ادمج("")
    خارج.اضف(مصدر == عدم ? ك_ : اساس.لون_من(تدرج.لون_عند(مصدر, ت), ك_))
  }
  ارجع خارج.ادمج("\n")
}
