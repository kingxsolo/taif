// سمة: أدوار لونية معنوية (نجاح، خطأ، تحذير...) وسمات جاهزة (دراكولا، نورد، ...)
استورد "./بيانات"
استورد "./اساس"
استورد "./لونيات"

خل _س = {"اسم": "افتراضي", "الوان": {}}
لكل ك, ق في بيانات.سمات["افتراضي"] { _س["الوان"][ك] = ق }

دالة اسماء_السمات() {
  خل خ = []
  لكل ن, ق في بيانات.سمات { خ.اضف(ن) }
  ارجع خ
}
// ضبط_سمة("دراكولا") أو ضبط_سمة({"نجاح": "#0f0"}) لتعديل أدوار محددة فوق السمة الحالية
دالة ضبط_سمة(س) {
  اذا نوع(س) == "قاموس" {
    لكل ك, ق في س { _س["الوان"][ك] = ق }
    _س["اسم"] = "مخصصة"
    ارجع
  }
  خل ن = لونيات.طبع_عربي(بيانات.سمات_بديلة.احصل(نص(س).صغير()) ?? س)
  لكل اسم, ق في بيانات.سمات {
    اذا لونيات.طبع_عربي(اسم) == ن {
      _س["الوان"] = {}
      لكل ك, ل في ق { _س["الوان"][ك] = ل }
      _س["اسم"] = اسم
      ارجع
    }
  }
  ارمي "سمة غير معروفة: ${س}"
}
دالة سمة_حالية() { ارجع _س["اسم"] }
دالة الوان_السمة() { ارجع _س["الوان"] }

// مواصفة لون دور معين (للاستعمال داخل نمط)
دالة مواصفة(دور_) {
  خل ق = _س["الوان"].احصل(دور_)
  اذا ق == عدم { ارمي "دور غير معروف في السمة: ${دور_}" }
  ارجع ق
}
// دالة تلوين لدور: دور("نجاح")("تم")
دالة دور(اسم) { ارجع اساس.نمط(مواصفة(اسم)) }
// كائن لون لدور (مفيد للخلفيات والتدرجات)
دالة لون_دور(اسم) {
  خل م = مواصفة(اسم)
  ارجع لونيات.لون.من_نص(م)
}

خل _رموز_ادوار = {"نجاح": "✔", "خطأ": "✖", "تحذير": "⚠", "معلومة": "ℹ", "مميز": "★", "خافت": "·"}
دالة رمز_دور(اسم) { ارجع _رموز_ادوار.احصل(اسم, "•") }

// رسائل جاهزة (تعيد نصاً ولا تطبع)
دالة رسالة(نوع_, ن) { ارجع دور(نوع_)(رمز_دور(نوع_)) + " " + ن }
دالة نجاح(ن) { ارجع رسالة("نجاح", ن) }
دالة خطأ(ن) { ارجع رسالة("خطأ", ن) }
دالة تحذير(ن) { ارجع رسالة("تحذير", ن) }
دالة معلومة(ن) { ارجع رسالة("معلومة", ن) }
