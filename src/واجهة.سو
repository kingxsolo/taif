دالة _هوية(ن) { ارجع ن }
// مواصفة نمط اختيارية → دالة (أو الهوية إن كانت فارغة)
دالة _نمط_او_هوية(م) {
  اذا م == عدم او م == "" { ارجع _هوية }
  ارجع اساس.نمط(م)
}
دالة _احرف_اطار(ن) {
  خل ك = لونيات.طبع_عربي(ن)
  خل اسم = بيانات.اطارات_بديلة.احصل(نص(ن).صغير()) ?? ن
  لكل ا, ق في بيانات.اطارات { اذا لونيات.طبع_عربي(ا) == لونيات.طبع_عربي(اسم) { ارجع ق } }
  ارمي "نمط إطار غير معروف: ${ن}"
}
دالة اسماء_الاطارات() { خل خ = []; لكل ا, ق في بيانات.اطارات { خ.اضف(ا) }; ارجع خ }

// ===================== الإطار =====================
// اطار(نص, {نمط, عنوان, تذييل, حشو, حشو_راسي, هامش, عرض ("كامل" أو رقم), محاذاة, محاذاة_عنوان,
//           لون_الاطار, لون_النص, لون_العنوان, خلفية})
دالة اطار(ن, خيارات = {}) {
  خل ز = _احرف_اطار(خيارات.احصل("نمط", "مفرد"))
  خل عنوان = خيارات.احصل("عنوان", ""); خل تذييل = خيارات.احصل("تذييل", "")
  خل حشو = خيارات.احصل("حشو", 1); خل حشو_ر = خيارات.احصل("حشو_راسي", 0)
  خل هامش = خيارات.احصل("هامش", 0)
  خل محاذاة = خيارات.احصل("محاذاة", "يسار"); خل مح_عنوان = خيارات.احصل("محاذاة_عنوان", "يسار")
  خل ف_اطار = _نمط_او_هوية(خيارات.احصل("لون_الاطار", عدم))
  خل ف_نص = _نمط_او_هوية(خيارات.احصل("لون_النص", عدم))
  خل ف_عنوان = _نمط_او_هوية(خيارات.احصل("لون_العنوان", "غامق"))
  خل ف_خلفية = _نمط_او_هوية(خيارات.احصل("خلفية", عدم))
  خل عرض = خيارات.احصل("عرض", عدم)
  خل اقصى = اساس.عرض_الطرفية() - هامش
  اذا عرض == "كامل" او عرض == "full" { عرض = اقصى }
  اذا عرض != عدم و عرض > اقصى { عرض = اقصى }

  خل سطور = نص(ن).قسم("\n")
  خل زائد = 2 + 2 * حشو
  خل داخل = 0
  لكل س في سطور { داخل = رياضيات.اكبر(داخل, اساس.طول_مرئي(س)) }
  اذا عرض != عدم { داخل = عرض - زائد }
  والا_اذا داخل + زائد > اقصى { داخل = اقصى - زائد }
  اذا داخل < 1 { داخل = 1 }
  // لفّ الأسطر الأطول من المتاح
  خل مسطحة = []
  لكل س في سطور {
    اذا اساس.طول_مرئي(س) > داخل { لكل ج في اساس.لف_نص(س, داخل) { مسطحة.اضف(ج) } }
    والا { مسطحة.اضف(س) }
  }
  خل كلي = داخل + 2 * حشو
  خل عط = اساس.طول_مرئي(عنوان) + 2; خل تط = اساس.طول_مرئي(تذييل) + 2
  اذا عنوان != "" و عط + 2 > كلي { كلي = عط + 2 }
  اذا تذييل != "" و تط + 2 > كلي { كلي = تط + 2 }
  داخل = كلي - 2 * حشو

  خل حافة = دالة(يسار_, وسط_, يمين_, ن_, ف) {
    خل فراغ = كلي
    اذا ن_ == "" { ارجع ف_اطار(يسار_ + وسط_ * فراغ + يمين_) }
    خل مقطع = " " + ن_ + " "
    خل م = اساس.طول_مرئي(مقطع)
    خل باقي = فراغ - م
    خل ي = 1; خل ر = باقي - 1
    اذا ف == "وسط" او ف == "center" { ي = رياضيات.ارضي(باقي / 2); ر = باقي - ي }
    والا_اذا ف == "يمين" او ف == "right" { ي = باقي - 1; ر = 1 }
    ارجع ف_اطار(يسار_ + وسط_ * ي) + ف_عنوان(مقطع) + ف_اطار(وسط_ * ر + يمين_)
  }
  خل بادئة = " " * هامش
  خل خارج = []
  خارج.اضف(بادئة + حافة(ز[0], ز[1], ز[2], عنوان, مح_عنوان))
  خل فارغ_سطر = ف_اطار(ز[3]) + ف_خلفية(" " * كلي) + ف_اطار(ز[3])
  لكل ي في مدى(0, حشو_ر) { خارج.اضف(بادئة + فارغ_سطر) }
  خل ح = " " * حشو
  لكل س في مسطحة {
    خارج.اضف(بادئة + ف_اطار(ز[3]) + ف_خلفية(ح + اساس.املأ(ف_نص(س), داخل, محاذاة) + ح) + ف_اطار(ز[3]))
  }
  لكل ي في مدى(0, حشو_ر) { خارج.اضف(بادئة + فارغ_سطر) }
  خارج.اضف(بادئة + حافة(ز[4], ز[1], ز[5], تذييل, "يمين"))
  ارجع خارج.ادمج("\n")
}

// ===================== خط فاصل =====================
دالة خط(عنوان = "", عرض = عدم, ح = "─", محاذاة = "وسط", لون_ = عدم) {
  خل ع = عرض ?? اساس.عرض_الطرفية()
  خل ف = _نمط_او_هوية(لون_)
  اذا عنوان == "" { ارجع ف(ح * ع) }
  خل م = " " + عنوان + " "
  خل باقي = ع - اساس.طول_مرئي(م)
  اذا باقي < 2 { ارجع م }
  خل ي = رياضيات.ارضي(باقي / 2)
  اذا محاذاة == "يسار" او محاذاة == "left" { ي = 2 }
  اذا محاذاة == "يمين" او محاذاة == "right" { ي = باقي - 2 }
  ارجع ف(ح * ي) + م + ف(ح * (باقي - ي))
}

// ===================== جدول =====================
// جدول(صفوف, {رؤوس, نمط, محاذاة (قائمة أو نص), حشو, خطوط_صفوف, مخطط, لون_مخطط, لون_رأس,
//             لون_الاطار, الوان_اعمدة (قائمة)، عنوان, عرض_اقصى})
دالة جدول(صفوف, خيارات = {}) {
  خل ز = _احرف_اطار(خيارات.احصل("نمط", "مفرد"))
  خل رؤوس = خيارات.احصل("رؤوس", عدم)
  خل حشو = خيارات.احصل("حشو", 1)
  خل ف_اطار = _نمط_او_هوية(خيارات.احصل("لون_الاطار", عدم))
  خل ف_رأس = _نمط_او_هوية(خيارات.احصل("لون_رأس", "غامق"))
  خل مخطط = خيارات.احصل("مخطط", غلط)
  خل ف_مخطط = _نمط_او_هوية(خيارات.احصل("لون_مخطط", "على ansi:236"))
  خل خطوط = خيارات.احصل("خطوط_صفوف", غلط)
  خل الوان = خيارات.احصل("الوان_اعمدة", [])
  خل عنوان = خيارات.احصل("عنوان", "")
  خل اقصى = خيارات.احصل("عرض_اقصى", اساس.عرض_الطرفية())
  خل كل = []
  اذا رؤوس != عدم { كل.اضف(رؤوس) }
  لكل ص في صفوف { كل.اضف(ص) }
  خل ن_اعمدة = 0
  لكل ص في كل { ن_اعمدة = رياضيات.اكبر(ن_اعمدة, ص.طول) }
  اذا ن_اعمدة == 0 { ارجع "" }
  // خلايا نصية وأنواعها الأصلية
  خل خلايا = []; خل ارقام = []
  لكل ص في كل {
    خل ق = []; خل ا = []
    لكل ي في مدى(0, ن_اعمدة) {
      خل ك = ي < ص.طول ? ص[ي] : ""
      ق.اضف(نص(ك).قسم("\n")); ا.اضف(نوع(ك) == "رقم")
    }
    خلايا.اضف(ق); ارقام.اضف(ا)
  }
  خل اعراض = []
  لكل ي في مدى(0, ن_اعمدة) {
    خل ع = 1
    لكل ص في خلايا { لكل س في ص[ي] { ع = رياضيات.اكبر(ع, اساس.طول_مرئي(س)) } }
    اعراض.اضف(ع)
  }
  خل كلي = دالة() { خل م = ن_اعمدة + 1; لكل ع في اعراض { م += ع + 2 * حشو }; ارجع م }
  طالما كلي() > اقصى {
    خل ا = 0
    لكل ي في مدى(0, ن_اعمدة) { اذا اعراض[ي] > اعراض[ا] { ا = ي } }
    اذا اعراض[ا] <= 3 { توقف }
    اعراض[ا] -= 1
  }
  خل مح = دالة(ي, رقمي) {
    خل ق = خيارات.احصل("محاذاة", عدم)
    اذا نوع(ق) == "قائمة" { ارجع ي < ق.طول ? ق[ي] : "يسار" }
    اذا ق != عدم { ارجع ق }
    ارجع رقمي ? "يمين" : "يسار"
  }
  خل فاصل = دالة(ي_, و_, ن_, ر_) {
    خل اج = []
    لكل ع في اعراض { اج.اضف(ز[1] * (ع + 2 * حشو)) }
    ارجع ف_اطار(ي_ + اج.ادمج(و_) + ر_)
  }
  خل خارج = []
  اذا عنوان != "" { خارج.اضف(اساس.املأ(اساس.غامق(عنوان), كلي(), "وسط")) }
  خارج.اضف(فاصل(ز[0], ز[8], 0, ز[2]))
  لكل ر, ص في خلايا {
    خل ارتفاع = 1
    لكل ق في ص { ارتفاع = رياضيات.اكبر(ارتفاع, ق.طول) }
    خل رأس = رؤوس != عدم و ر == 0
    خل رقم_صف = رؤوس != عدم ? ر - 1 : ر
    خل ظل = مخطط و ليس رأس و رقم_صف % 2 == 1
    لكل س في مدى(0, ارتفاع) {
      خل اج = []
      لكل ي في مدى(0, ن_اعمدة) {
        خل ق = ص[ي]
        خل نصي = س < ق.طول ? ق[س] : ""
        نصي = اساس.قص(نصي, اعراض[ي])
        اذا رأس { نصي = ف_رأس(نصي) }
        والا_اذا ي < الوان.طول و الوان[ي] != عدم { نصي = اساس.نمط(الوان[ي])(نصي) }
        خل ملء = اساس.املأ(نصي, اعراض[ي], رأس ? "وسط" : مح(ي, ارقام[ر][ي]))
        خل خلية = " " * حشو + ملء + " " * حشو
        اج.اضف(ظل ? ف_مخطط(خلية) : خلية)
      }
      خارج.اضف(ف_اطار(ز[3]) + اج.ادمج(ف_اطار(ز[3])) + ف_اطار(ز[3]))
    }
    اذا رأس { خارج.اضف(فاصل(ز[6], ز[10], 0, ز[7])) }
    والا_اذا خطوط و ر < خلايا.طول - 1 { خارج.اضف(فاصل(ز[6], ز[10], 0, ز[7])) }
  }
  خارج.اضف(فاصل(ز[4], ز[9], 0, ز[5]))
  ارجع خارج.ادمج("\n")
}

// ===================== قوائم وأشجار =====================
دالة _قائمة_اسطر(عناصر, عمق, خ, اسطر) {
  خل رصاصات = خ.احصل("رصاصات", ["•", "◦", "▪"])
  خل مرقمة = خ.احصل("مرقمة", غلط)
  خل ف_رمز = _نمط_او_هوية(خ.احصل("لون_رمز", "خافت"))
  خل عداد = 0
  لكل ع في عناصر {
    اذا نوع(ع) == "قائمة" { _قائمة_اسطر(ع, عمق + 1, خ, اسطر); استمر }
    عداد += 1
    خل رمز_ = مرقمة ? "${عداد}." : رصاصات[عمق % رصاصات.طول]
    اسطر.اضف("  " * عمق + ف_رمز(رمز_) + " " + نص(ع))
  }
}
// قائمة(["أ", "ب", ["فرعي1", "فرعي2"], "ج"], {مرقمة, رصاصات, لون_رمز})
دالة قائمة(عناصر, خيارات = {}) {
  خل اسطر = []
  _قائمة_اسطر(عناصر, 0, خيارات, اسطر)
  ارجع اسطر.ادمج("\n")
}

دالة _شجرة_اسطر(عقدة, بادئة, خ, اسطر) {
  خل ف_فرع = _نمط_او_هوية(خ.احصل("لون_فرع", "خافت"))
  خل ف_مفتاح = _نمط_او_هوية(خ.احصل("لون_مفتاح", "غامق"))
  خل ف_قيمة = _نمط_او_هوية(خ.احصل("لون_قيمة", عدم))
  خل مدخلات = []
  اذا نوع(عقدة) == "قاموس" { لكل ك, ق في عقدة { مدخلات.اضف([نص(ك), ق]) } }
  والا { لكل ي, ق في عقدة { مدخلات.اضف([عدم, ق]) } }
  لكل ي, م في مدخلات {
    خل اخير = ي == مدخلات.طول - 1
    خل وصلة = ف_فرع(اخير ? "└── " : "├── ")
    خل ابن = م[1]
    خل مركب = نوع(ابن) == "قاموس" او نوع(ابن) == "قائمة"
    اذا م[0] == عدم {
      اذا مركب { اسطر.اضف(بادئة + وصلة + ف_مفتاح("[${ي}]")) }
      والا { اسطر.اضف(بادئة + وصلة + ف_قيمة(نص(ابن))) }
    } والا {
      اذا مركب { اسطر.اضف(بادئة + وصلة + ف_مفتاح(م[0])) }
      والا { اسطر.اضف(بادئة + وصلة + ف_مفتاح(م[0]) + ": " + ف_قيمة(نص(ابن))) }
    }
    اذا مركب { _شجرة_اسطر(ابن, بادئة + ف_فرع(اخير ? "    " : "│   "), خ, اسطر) }
  }
}
// شجرة({"src": {"a.سو": "1KB", "b.سو": "2KB"}, "README": "ok"}, {عنوان: "مشروع"})
دالة شجرة(بيانات_, خيارات = {}) {
  خل اسطر = []
  خل عنوان = خيارات.احصل("عنوان", عدم)
  اذا عنوان != عدم { اسطر.اضف(_نمط_او_هوية(خيارات.احصل("لون_عنوان", "غامق"))(عنوان)) }
  _شجرة_اسطر(بيانات_, "", خيارات, اسطر)
  ارجع اسطر.ادمج("\n")
}

// ===================== شارات وتنبيهات =====================
// شارة("جديد", "#e11d48") ← نص على خلفية ملونة بلون نص مناسب تلقائياً
دالة شارة(ن, ل = "#3b82f6") {
  ارجع اساس.غامق(اساس.شارة_لون(ل, " ${ن} "))
}
خل _انواع_تنبيه = {
  "نجاح": "نجاح", "success": "نجاح", "خطأ": "خطأ", "خطا": "خطأ", "error": "خطأ",
  "تحذير": "تحذير", "warning": "تحذير", "warn": "تحذير", "معلومة": "معلومة", "info": "معلومة"
}
دالة تنبيه(نوع_, ن, عنوان = عدم, خيارات = {}) {
  خل د = _انواع_تنبيه.احصل(نص(نوع_).صغير()) ?? _انواع_تنبيه.احصل(لونيات.طبع_عربي(نوع_))
  اذا د == عدم { ارمي "نوع تنبيه غير معروف: ${نوع_}" }
  خل ف = سمة.دور(د)
  خل خ = {"نمط": خيارات.احصل("نمط", "مدور"), "لون_الاطار": سمة.مواصفة(د), "حشو": 1,
          "عنوان": ف(سمة.رمز_دور(د) + " " + (عنوان ?? د)), "لون_العنوان": "غامق"}
  لكل ك, ق في خيارات { خ[ك] = ق }
  ارجع اطار(ن, خ)
}

// ===================== أشرطة التقدم =====================
خل _انماط_شريط = {
  "كتل": {"ممتلئ": "█", "فارغ": "░", "اجزاء": ["▏", "▎", "▍", "▌", "▋", "▊", "▉"]},
  "ناعم": {"ممتلئ": "█", "فارغ": " ", "اجزاء": ["▏", "▎", "▍", "▌", "▋", "▊", "▉"]},
  "خطوط": {"ممتلئ": "━", "فارغ": "─", "اجزاء": []},
  "نقاط": {"ممتلئ": "●", "فارغ": "○", "اجزاء": []},
  "مربعات": {"ممتلئ": "■", "فارغ": "□", "اجزاء": []},
  "اسهم": {"ممتلئ": "=", "فارغ": " ", "رأس": ">", "اجزاء": []},
  "اسكي": {"ممتلئ": "#", "فارغ": "-", "اجزاء": []}
}
// شريط بلا نسبة مئوية: خيارات {نمط, تدرج, لون, لون_فارغ}
دالة شريط_نسبة(نسبة, عرض = 30, خيارات = {}) {
  خل ن = نسبة < 0 ? 0 : (نسبة > 1 ? 1 : نسبة)
  خل م = _انماط_شريط.احصل(لونيات.طبع_عربي(خيارات.احصل("نمط", "كتل")))
  اذا م == عدم { ارمي "نمط شريط غير معروف: ${خيارات.احصل("نمط", "كتل")}" }
  خل مصدر = خيارات.احصل("تدرج", عدم)
  خل ف_لون = _نمط_او_هوية(مصدر == عدم ? خيارات.احصل("لون", "اخضر") : عدم)
  خل ف_فارغ = _نمط_او_هوية(خيارات.احصل("لون_فارغ", "خافت"))
  خل حقل = ن * عرض
  خل كامل = رياضيات.ارضي(حقل)
  خل جزء = حقل - كامل
  خل مقاطع = []
  لكل ي في مدى(0, كامل) {
    خل خ = م["ممتلئ"]
    اذا م.احصل("رأس") != عدم و ي == كامل - 1 و ن < 1 { خ = م["رأس"] }
    اذا مصدر != عدم {
      خل ل = تدرج.لون_عند(مصدر, عرض <= 1 ? 0 : ي / (عرض - 1))
      مقاطع.اضف(اساس.لون_من(ل, خ))
    } والا { مقاطع.اضف(ف_لون(خ)) }
  }
  خل مستعمل = كامل
  خل اجزاء = م["اجزاء"]
  اذا كامل < عرض و اجزاء.طول > 0 و جزء > 0 {
    خل ف = رياضيات.بتر(جزء * (اجزاء.طول + 1))
    اذا ف > 0 {
      خل خ = اجزاء[ف - 1]
      مقاطع.اضف(مصدر != عدم ? اساس.لون_من(تدرج.لون_عند(مصدر, عرض <= 1 ? 0 : كامل / (عرض - 1)), خ) : ف_لون(خ))
      مستعمل += 1
    }
  }
  اذا مستعمل < عرض { مقاطع.اضف(ف_فارغ(م["فارغ"] * (عرض - مستعمل))) }
  ارجع مقاطع.ادمج("")
}
// شريط مع النسبة: شريط_تقدم(0.5, 20) ← ██████████░░░░░░░░░░ 50%
دالة شريط_تقدم(نسبة, عرض = 20, خيارات = {}) {
  خل ن = نسبة < 0 ? 0 : (نسبة > 1 ? 1 : نسبة)
  ارجع شريط_نسبة(ن, عرض, خيارات) + " " + اساس.املأ(نسق("{:.0f}", ن * 100) + "%", 4, "يمين")
}

دالة _مدة(ث) {
  اذا ث < 0 { ث = 0 }
  خل ك = رياضيات.بتر(ث)
  خل د = ك \ 60; خل ص = ك % 60
  ارجع د >= 60 ? "${د \ 60}:${نسق("{:02d}", د % 60)}:${نسق("{:02d}", ص)}" : "${نسق("{:02d}", د)}:${نسق("{:02d}", ص)}"
}

// شريط تقدم حيّ يُرسم في مكانه. خيارات: {وصف, عرض, نمط, تدرج, لون, اظهر_الوقت}
صنف شريط {
  دالة بناء(اجمالي, خيارات = {}) {
    هذا.اجمالي = اجمالي; هذا.قيمة = 0; هذا.خيارات = خيارات
    هذا.وصف = خيارات.احصل("وصف", ""); هذا.بداية = زمن.ساعة(); هذا.اخير = -1; هذا.رسم_اخير = ""
  }
  دالة سطر() {
    خل ن = هذا.اجمالي <= 0 ? 1 : هذا.قيمة / هذا.اجمالي
    خل عرض = هذا.خيارات.احصل("عرض", 30)
    خل ب = شريط_نسبة(ن, عرض, هذا.خيارات)
    خل خ = []
    اذا هذا.وصف != "" { خ.اضف(هذا.وصف) }
    خ.اضف(ب)
    خ.اضف(اساس.املأ(نسق("{:.0f}", ن * 100) + "%", 4, "يمين"))
    خ.اضف("${رياضيات.بتر(هذا.قيمة)}/${هذا.اجمالي}")
    اذا هذا.خيارات.احصل("اظهر_الوقت", صح) {
      خل م = زمن.ساعة() - هذا.بداية
      خل متبق = هذا.قيمة > 0 ? م / هذا.قيمة * (هذا.اجمالي - هذا.قيمة) : 0
      خ.اضف(اساس.خافت("${_مدة(م)}<${_مدة(متبق)}"))
    }
    ارجع خ.ادمج(" ")
  }
  دالة ارسم(اجبار = غلط) {
    خل الان = زمن.ساعة()
    اذا ليس اجبار و هذا.اخير >= 0 و الان - هذا.اخير < 0.05 { ارجع }
    هذا.اخير = الان
    اذا اساس.طرفية_حية() { اكتب("\r" + هذا.سطر() + "\x1b[K") }
  }
  دالة حدّث(ق, وصف = عدم) {
    هذا.قيمة = ق > هذا.اجمالي ? هذا.اجمالي : ق
    اذا وصف != عدم { هذا.وصف = وصف }
    هذا.ارسم()
  }
  دالة تقدم(ن = 1, وصف = عدم) { هذا.حدّث(هذا.قيمة + ن, وصف) }
  دالة اتمم() {
    هذا.قيمة = هذا.اجمالي
    اذا اساس.طرفية_حية() { هذا.ارسم(صح); اطبع("") } والا { اطبع(هذا.سطر()) }
  }
}
