// اساس: طبقة الطرفية: كشف الدعم، أكواد ANSI، محلّل الأنماط، وأدوات قياس النصوص
استورد "نظام"
استورد "رياضيات"
استورد "./لونيات"
استورد "./بيانات"

خل ESC = "\x1b"
خل _CSI = ESC + "["

// ===================== كشف قدرات الطرفية =====================
// قراءات آمنة: إن مُنعت الصلاحية (بيئة/تنفيذ) نعود لقيمة افتراضية بدل الانهيار
دالة _بيئة(ن) {
  حاول { ارجع نظام.بيئة(ن) } امسك (خ) { ارجع عدم }
}
دالة _طرفية() {
  حاول { ارجع نظام.طرفية() } امسك (خ) { ارجع غلط }
}

// المستويات: 0 بلا ألوان · 1 ستة عشر لوناً · 2 مئتان وستة وخمسون · 3 ألوان حقيقية (24 بت)
دالة كشف_المستوى(تجاهل_الطرفية = غلط) {
  خل بيئة = _بيئة
  اذا (بيئة("NO_COLOR") ?? "") != "" { ارجع 0 }
  خل ف = بيئة("FORCE_COLOR")
  اذا ف != عدم {
    اذا ف == "0" او ف == "false" { ارجع 0 }
    اذا ف == "2" { ارجع 2 }
    اذا ف == "3" { ارجع 3 }
    اذا ف == "1" او ف == "true" او ف == "" { ارجع 1 }
  }
  اذا ليس تجاهل_الطرفية و ليس _طرفية() { ارجع 0 }
  خل ت = (بيئة("TERM") ?? "").صغير()
  اذا ت == "dumb" { ارجع 0 }
  خل ع = (بيئة("COLORTERM") ?? "").صغير()
  اذا ع == "truecolor" او ع == "24bit" { ارجع 3 }
  اذا (بيئة("WT_SESSION") ?? "") != "" او (بيئة("KONSOLE_VERSION") ?? "") != "" { ارجع 3 }
  اذا ت.يحتوي("256") { ارجع 2 }
  اذا ت.يحتوي("kitty") او ت.يحتوي("alacritty") او ت.يحتوي("wezterm") او ت.يحتوي("direct") { ارجع 3 }
  اذا ت != "" { ارجع 1 }
  ارجع 0
}

خل _حالة = {"مستوى": كشف_المستوى(), "عرض": عدم}

دالة مستوى() { ارجع _حالة["مستوى"] }
دالة ضبط_المستوى(ن) {
  اذا ن < 0 او ن > 3 { ارمي "المستوى بين 0 و3" }
  _حالة["مستوى"] = ن
}
// ضبط(صح/غلط): يفرض التفعيل أو التعطيل (صح تعطي المستوى المكتشف مع تجاهل كون المخرجات طرفية)
دالة ضبط(قيمة) {
  اذا قيمة { خل م = كشف_المستوى(صح); _حالة["مستوى"] = م == 0 ? 1 : م }
  والا { _حالة["مستوى"] = 0 }
}

دالة عرض_الطرفية() {
  اذا _حالة["عرض"] != عدم { ارجع _حالة["عرض"] }
  خل ق = رقم(_بيئة("COLUMNS") ?? "")
  اذا ق == عدم او ق < 10 {
    ق = عدم
    اذا _طرفية() {
      حاول { ق = رقم(نظام.نفذ("tput cols 2>/dev/null").نظف()) } امسك (خ) { ق = عدم }
    }
  }
  اذا ق == عدم او ق < 10 { ق = 80 }
  ارجع ق
}
دالة اضبط_العرض(ن) { _حالة["عرض"] = ن }

// ===================== قياس النصوص (يتجاهل أكواد ANSI ويفهم التشكيل والرموز العريضة) =====================
دالة عرض_رمز(ر) {
  اذا ر < 32 { ارجع 0 }
  اذا ر < 768 { ارجع 1 }
  اذا (ر >= 768 و ر <= 879) او (ر >= 1155 و ر <= 1161) { ارجع 0 }
  اذا (ر >= 1611 و ر <= 1631) او ر == 1648 او (ر >= 1750 و ر <= 1773) { ارجع 0 }
  اذا (ر >= 8203 و ر <= 8207) او (ر >= 8234 و ر <= 8238) او (ر >= 8288 و ر <= 8292) { ارجع 0 }
  اذا (ر >= 65024 و ر <= 65039) او ر == 65279 او (ر >= 6832 و ر <= 6911) او (ر >= 7616 و ر <= 7679) { ارجع 0 }
  اذا (ر >= 4352 و ر <= 4447) او (ر >= 11904 و ر <= 42191) او (ر >= 44032 و ر <= 55203) { ارجع 2 }
  اذا (ر >= 63744 و ر <= 64255) او (ر >= 65072 و ر <= 65135) او (ر >= 65280 و ر <= 65376) او (ر >= 65504 و ر <= 65510) { ارجع 2 }
  اذا (ر >= 127744 و ر <= 128591) او (ر >= 129280 و ر <= 129791) او (ر >= 126976 و ر <= 127487) او (ر >= 131072 و ر <= 262141) { ارجع 2 }
  ارجع 1
}

// يفكك النص إلى رموز: [نوع، نص، عرض] حيث النوع "a" كود تحكم أو "c" حرف
دالة رموز_النص(ن) {
  خل ح = نص(ن).حروف()
  خل ط = ح.طول
  خل خ = []
  خل ي = 0
  طالما ي < ط {
    خل ك = ح[ي]
    اذا ك == ESC {
      خل ج = ي + 1
      اذا ج < ط و ح[ج] == "[" {
        ج += 1
        طالما ج < ط و (رمز(ح[ج]) < 64 او رمز(ح[ج]) > 126) { ج += 1 }
        ج += 1
      } والا_اذا ج < ط و ح[ج] == "]" {
        ج += 1
        طالما ج < ط {
          اذا ح[ج] == "\x07" { ج += 1; توقف }
          اذا ح[ج] == ESC و ج + 1 < ط و ح[ج + 1] == "\\" { ج += 2; توقف }
          ج += 1
        }
      } والا { ج += 1 }
      خل م = []
      لكل ز في مدى(ي, رياضيات.اصغر(ج, ط)) { م.اضف(ح[ز]) }
      خ.اضف(["a", م.ادمج(""), 0])
      ي = ج
    } والا {
      خ.اضف(["c", ك, عرض_رمز(رمز(ك))])
      ي += 1
    }
  }
  ارجع خ
}
دالة ازل(ن) {
  خل خ = []
  لكل ر في رموز_النص(ن) { اذا ر[0] == "c" { خ.اضف(ر[1]) } }
  ارجع خ.ادمج("")
}
دالة طول_مرئي(ن) {
  خل ع = 0
  لكل ر في رموز_النص(ن) { ع += ر[2] }
  ارجع ع
}
// مجموعات حروف: الحرف مع علاماته (التشكيل) كوحدة واحدة
دالة احرف(ن) {
  خل خ = []
  لكل ر في رموز_النص(ن) {
    اذا ر[0] == "c" و ر[2] == 0 و خ.طول > 0 { خ[خ.طول - 1] = خ[خ.طول - 1] + ر[1] }
    والا { خ.اضف(ر[1]) }
  }
  ارجع خ
}

دالة كرر_حرف(ح, ن) { ارجع ن > 0 ? ح * رياضيات.بتر(ن) : "" }
// محاذاة: "يسار" (الافتراضي) · "يمين" · "وسط" ؛ تُقاس بالعرض المرئي
دالة املأ(ن, عرض, محاذاة = "يسار", ح = " ") {
  خل ف = عرض - طول_مرئي(ن)
  اذا ف <= 0 { ارجع ن }
  اذا محاذاة == "يمين" او محاذاة == "right" { ارجع كرر_حرف(ح, ف) + ن }
  اذا محاذاة == "وسط" او محاذاة == "center" {
    خل ي = رياضيات.ارضي(ف / 2)
    ارجع كرر_حرف(ح, ي) + ن + كرر_حرف(ح, ف - ي)
  }
  ارجع ن + كرر_حرف(ح, ف)
}
// قصّ حتى عرض مرئي معين مع الحفاظ على الألوان
دالة قص(ن, عرض, لاحقة = "…") {
  اذا طول_مرئي(ن) <= عرض { ارجع ن }
  خل حد = عرض - طول_مرئي(لاحقة)
  اذا حد < 0 { حد = 0 }
  خل خ = []; خل ع = 0; خل ملون = غلط
  لكل ر في رموز_النص(ن) {
    اذا ر[0] == "a" { خ.اضف(ر[1]); ملون = صح; استمر }
    اذا ع + ر[2] > حد { توقف }
    خ.اضف(ر[1]); ع += ر[2]
  }
  اذا ملون { خ.اضف(_CSI + "0m") }
  خ.اضف(لاحقة)
  ارجع خ.ادمج("")
}
// لفّ النص على أسطر بعرض معين (يكسر عند الفراغات، ويكسر الكلمة الطويلة جداً)
دالة لف_نص(ن, عرض) {
  خل نتيجة = []
  لكل سطر في نص(ن).قسم("\n") {
    اذا طول_مرئي(سطر) <= عرض { نتيجة.اضف(سطر); استمر }
    خل حالي = ""
    لكل كلمة في سطر.قسم(" ") {
      خل ك = كلمة
      طالما طول_مرئي(ك) > عرض {
        اذا حالي != "" { نتيجة.اضف(حالي); حالي = "" }
        خل جزء = قص(ك, عرض, "")
        اذا جزء == "" { توقف }
        نتيجة.اضف(جزء)
        ك = ك.جزء(ازل(جزء).طول)
      }
      اذا حالي == "" { حالي = ك }
      والا_اذا طول_مرئي(حالي) + 1 + طول_مرئي(ك) <= عرض { حالي = حالي + " " + ك }
      والا { نتيجة.اضف(حالي); حالي = ك }
    }
    نتيجة.اضف(حالي)
  }
  ارجع نتيجة
}

// ===================== تحويل الألوان إلى أكواد حسب مستوى الطرفية =====================
خل _مستويات_المكعب = [0, 95, 135, 175, 215, 255]

دالة ansi256_الى_rgb(ن) {
  اذا ن < 16 { ارجع بيانات.ANSI16[ن] }
  اذا ن >= 232 { خل ق = 8 + 10 * (ن - 232); ارجع [ق, ق, ق] }
  خل ع = ن - 16
  ارجع [_مستويات_المكعب[ع \ 36], _مستويات_المكعب[(ع \ 6) % 6], _مستويات_المكعب[ع % 6]]
}
دالة _مسافة(أ, ب) {
  خل م = (أ[0] + ب[0]) / 2
  خل ر = أ[0] - ب[0]; خل غ = أ[1] - ب[1]; خل ز = أ[2] - ب[2]
  ارجع (2 + م / 256) * ر * ر + 4 * غ * غ + (2 + (255 - م) / 256) * ز * ز
}
دالة rgb_الى_ansi16(ر, غ, ب) {
  خل افضل = 0; خل م = 1e12
  لكل ي في مدى(0, 16) {
    خل د = _مسافة([ر, غ, ب], بيانات.ANSI16[ي])
    اذا د < م { م = د; افضل = ي }
  }
  ارجع افضل
}
دالة rgb_الى_ansi256(ر, غ, ب) {
  خل ق = [رياضيات.قرب(ر), رياضيات.قرب(غ), رياضيات.قرب(ب)]
  خل مكعب = 16 + 36 * رياضيات.قرب(ق[0] / 255 * 5) + 6 * رياضيات.قرب(ق[1] / 255 * 5) + رياضيات.قرب(ق[2] / 255 * 5)
  خل رمادي_د = رياضيات.قرب((ق[0] + ق[1] + ق[2]) / 3)
  خل ر_رمادي = رمادي_د < 8 ? 16 : (رمادي_د > 248 ? 231 : 232 + رياضيات.قرب((رمادي_د - 8) / 247 * 24))
  خل د1 = _مسافة(ق, ansi256_الى_rgb(مكعب)); خل د2 = _مسافة(ق, ansi256_الى_rgb(ر_رمادي))
  ارجع د2 < د1 ? ر_رمادي : مكعب
}

// يولّد كود SGR لون: النوع "a" دليل 0-15 · "x" دليل 0-255 · "r" قائمة rgb
دالة _كود_لون(نوع_, قيمة, خلفية) {
  خل م = _حالة["مستوى"]
  خل اساس = خلفية ? 48 : 38
  اذا نوع_ == "a" {
    ارجع قيمة < 8 ? نص((خلفية ? 40 : 30) + قيمة) : نص((خلفية ? 100 : 90) + قيمة - 8)
  }
  خل ق = نوع_ == "x" ? ansi256_الى_rgb(قيمة) : قيمة
  اذا م >= 3 { ارجع "${اساس};2;${رياضيات.قرب(ق[0])};${رياضيات.قرب(ق[1])};${رياضيات.قرب(ق[2])}" }
  اذا م == 2 { ارجع "${اساس};5;${نوع_ == "x" ? قيمة : rgb_الى_ansi256(ق[0], ق[1], ق[2])}" }
  خل ي = rgb_الى_ansi16(ق[0], ق[1], ق[2])
  ارجع ي < 8 ? نص((خلفية ? 40 : 30) + ي) : نص((خلفية ? 100 : 90) + ي - 8)
}

// ===================== محلّل الأنماط =====================
خل _سمات_نص = {
  "غامق": [1, 22], "bold": [1, 22], "خافت": [2, 22], "dim": [2, 22],
  "مائل": [3, 23], "italic": [3, 23], "مسطر": [4, 24], "underline": [4, 24],
  "وميض": [5, 25], "blink": [5, 25], "معكوس": [7, 27], "inverse": [7, 27], "reverse": [7, 27],
  "مخفي": [8, 28], "hidden": [8, 28], "مشطوب": [9, 29], "strike": [9, 29], "strikethrough": [9, 29],
  "مسطر_مزدوج": [21, 24], "فوق_خط": [53, 55], "overline": [53, 55]
}

دالة _قسّم_مواصفة(س) {
  خل خ = []; خل ح = ""; خل ع = 0
  لكل ك في نص(س) {
    اذا ك == "(" { ع += 1 }
    اذا ك == ")" { ع -= 1 }
    اذا ع == 0 و (ك == " " او ك == "," او ك == "+") {
      اذا ح != "" { خ.اضف(ح); ح = "" }
    } والا { ح += ك }
  }
  اذا ح != "" { خ.اضف(ح) }
  ارجع خ
}

// يحاول فهم رمز لون: يعيد [نوع، قيمة] أو عدم
دالة _لون_من_رمز(ر) {
  خل ك = لونيات.طبع_عربي(ر).ابدل(" ", "_")
  خل ا = بيانات.اسماء_ansi.احصل(ك)
  اذا ا != عدم { ارجع ["a", ا] }
  اذا ك.يبدأ_ب("ansi:") او ك.يبدأ_ب("256:") {
    خل ن = رقم(ك.جزء(ك.ابحث(":") + 1))
    اذا ن != عدم و ن >= 0 و ن <= 255 { ارجع ["x", ن] }
    ارجع عدم
  }
  حاول {
    خل ل = لونيات.لون.من_نص(ر)
    ارجع ["r", [ل.r, ل.g, ل.b]]
  } امسك (خ) { ارجع عدم }
}

// يحلل مواصفة نمط إلى عناصر، أو يعيد عدم إن فيها رمزاً غير معروف
دالة حلل_نمط(مواصفة) {
  خل عناصر = []
  خل رموز = _قسّم_مواصفة(مواصفة)
  خل ي = 0
  طالما ي < رموز.طول {
    خل ر = لونيات.طبع_عربي(رموز[ي])
    خل سمة = _سمات_نص.احصل(ر)
    اذا سمة != عدم { عناصر.اضف(["s", سمة[0], سمة[1]]) }
    والا_اذا ر == "علي" او ر == "on" {
      ي += 1
      اذا ي >= رموز.طول { ارجع عدم }
      خل ل = _لون_من_رمز(رموز[ي])
      اذا ل == عدم { ارجع عدم }
      عناصر.اضف(["b", ل[0], ل[1]])
    }
    والا_اذا ر.يبدأ_ب("خلفيه_") او ر.يبدأ_ب("bg_") او ر.يبدأ_ب("bg:") {
      خل ل = _لون_من_رمز(رموز[ي].جزء(ر.يبدأ_ب("bg_") او ر.يبدأ_ب("bg:") ? 3 : 6))
      اذا ل == عدم { ارجع عدم }
      عناصر.اضف(["b", ل[0], ل[1]])
    }
    والا {
      خل ل = _لون_من_رمز(رموز[ي])
      اذا ل == عدم { ارجع عدم }
      عناصر.اضف(["f", ل[0], ل[1]])
    }
    ي += 1
  }
  ارجع عناصر
}

دالة _فتح_غلق(ع) {
  اذا ع[0] == "s" { ارجع [نص(ع[1]), نص(ع[2])] }
  اذا ع[0] == "f" { ارجع [_كود_لون(ع[1], ع[2], غلط), "39"] }
  ارجع [_كود_لون(ع[1], ع[2], صح), "49"]
}

// يطبق عناصر نمط على نص (آمن للتداخل ومتعدد الأسطر)
دالة طبق(عناصر, ن) {
  خل س = نص(ن)
  اذا _حالة["مستوى"] == 0 او س == "" او عناصر.طول == 0 { ارجع س }
  خل فتح = []; خل غلق = []; خل ازواج = []
  لكل ع في عناصر {
    خل ز = _فتح_غلق(ع)
    فتح.اضف(ز[0]); غلق.اضف(_CSI + ز[1] + "m"); ازواج.اضف([_CSI + ز[1] + "m", _CSI + ز[0] + "m"])
  }
  خل بداية = _CSI + فتح.ادمج(";") + "m"
  خل نهاية = غلق.اعكس().ادمج("")
  خل لف_سطر = دالة(ق) {
    اذا ق == "" { ارجع ق }
    خل ج = ق
    لكل ز في ازواج { ج = ج.ابدل(ز[0], ز[0] + ز[1]) }
    ارجع بداية + ج + نهاية
  }
  اذا ليس س.يحتوي("\n") { ارجع لف_سطر(س) }
  ارجع س.قسم("\n").حول(لف_سطر).ادمج("\n")
}

// نمط(مواصفات...) ← دالة تلوّن النصوص. مثال: نمط("غامق احمر على ابيض"), نمط("#ff8800", "مسطر")
دالة نمط(...مواصفات) {
  خل عناصر = []
  لكل م في مواصفات {
    خل ح = حلل_نمط(م)
    اذا ح == عدم { ارمي "نمط غير معروف: ${م}" }
    لكل ع في ح { عناصر.اضف(ع) }
  }
  ارجع دالة(ن) { ارجع طبق(عناصر, ن) }
}

// ===================== دوال ألوان مخصصة =====================
دالة rgb(ر, غ, ب, ن) { ارجع طبق([["f", "r", [ر, غ, ب]]], ن) }
دالة خلفية_rgb(ر, غ, ب, ن) { ارجع طبق([["b", "r", [ر, غ, ب]]], ن) }
دالة هيكس(ه, ن) { ارجع لون_من(لونيات.لون.من_هيكس(ه), ن) }
دالة خلفية_هيكس(ه, ن) { ارجع خلفية_من(لونيات.لون.من_هيكس(ه), ن) }
دالة hsl(ه, س, ل, ن) { ارجع لون_من(لونيات.لون.من_hsl(ه, س, ل), ن) }
دالة لون256(ن_, ن) { ارجع طبق([["f", "x", ن_]], ن) }
دالة خلفية256(ن_, ن) { ارجع طبق([["b", "x", ن_]], ن) }
// يقبل كائن لون أو أي نص يفهمه (هيكس، اسم، rgb(...))
دالة _ككائن(ل) { ارجع نوع(ل) == "نص" ? لونيات.لون.من_نص(ل) : ل }
دالة لون_من(ل, ن) { خل ك = _ككائن(ل); ارجع طبق([["f", "r", [ك.r, ك.g, ك.b]]], ن) }
دالة خلفية_من(ل, ن) { خل ك = _ككائن(ل); ارجع طبق([["b", "r", [ك.r, ك.g, ك.b]]], ن) }
// لون + خلفية مضمونة القراءة (يختار الأسود أو الأبيض للنص تلقائياً)
دالة شارة_لون(ل, ن) {
  خل ك = _ككائن(ل)
  خل ن2 = ك.نص_مناسب()
  ارجع طبق([["f", "r", [ن2.r, ن2.g, ن2.b]], ["b", "r", [ك.r, ك.g, ك.b]]], ن)
}

// ===================== تحكم بالطرفية =====================
دالة طرفية_حية() { ارجع _طرفية() }
دالة _طرفية_حية() { ارجع _طرفية() }
دالة قراءة_بيئة(ن) { ارجع _بيئة(ن) }
دالة _تحكم(ك) { ارجع _طرفية_حية() ? ك : "" }
دالة اخف_المؤشر() { اكتب(_تحكم(_CSI + "?25l")) }
دالة اظهر_المؤشر() { اكتب(_تحكم(_CSI + "?25h")) }
دالة امسح_الشاشة() { اكتب(_تحكم(_CSI + "2J" + _CSI + "H")) }
دالة امسح_السطر() { اكتب(_تحكم("\r" + _CSI + "2K")) }
دالة اصعد(ن = 1) { اكتب(_تحكم(ن > 0 ? _CSI + نص(ن) + "A" : "")) }
دالة انزل(ن = 1) { اكتب(_تحكم(ن > 0 ? _CSI + نص(ن) + "B" : "")) }
دالة الى_العمود(ن) { اكتب(_تحكم(_CSI + نص(ن) + "G")) }
دالة عنوان_النافذة(ن) { اكتب(_تحكم(ESC + "]0;" + ن + "\x07")) }
دالة جرس() { اكتب(_تحكم("\x07")) }
// رابط قابل للنقر (OSC 8)؛ يعود لصيغة «نص (رابط)» حين لا تدعمه الطرفية
دالة رابط(ن, عنوان) {
  اذا _حالة["مستوى"] > 0 و _طرفية_حية() { ارجع ESC + "]8;;" + عنوان + ESC + "\\" + ن + ESC + "]8;;" + ESC + "\\" }
  ارجع "${ن} (${عنوان})"
}

