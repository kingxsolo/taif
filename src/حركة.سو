// حركة: حركات نصية بالألوان ودوارات انتظار. تعمل في الطرفية الحيّة فقط؛
// وفي غيرها (ملف، أنبوب، CI) تطبع الإطار النهائي مرة واحدة بلا ازدحام.
استورد "نظام"
استورد "زمن"
استورد "رياضيات"
استورد "عشوائي"
استورد "./اساس"
استورد "./تدرج"
استورد "./لونيات"
استورد "./بيانات"
استورد "./سمة"

دالة _حي() { ارجع اساس.طرفية_حية() و اساس.مستوى() > 0 }
دالة _ل(ل, ن) { ارجع اساس.لون_من(ل, ن) }
دالة _ك(ل) { ارجع نوع(ل) == "نص" ? لونيات.لون.من_نص(ل) : ل }

// يرسم إطاراً في مكان الإطار السابق ويعيد ارتفاعه
دالة _ارسم(ن, ارتفاع) {
  اذا ارتفاع > 1 { اكتب("\x1b[" + نص(ارتفاع - 1) + "A") }
  اكتب("\r")
  خل س = ن.قسم("\n")
  لكل ر, ط في س {
    اكتب("\x1b[2K" + ط)
    اذا ر < س.طول - 1 { اكتب("\n") }
  }
  ارجع س.طول
}

// تشغيل حركة عامة: دالة_اطار(رقم) تعيد نص الإطار. اكتب حركاتك الخاصة بها.
دالة شغل_حركة(دالة_اطار, عدد, فاصل = 0.05, ابق_الاخير = صح) {
  اذا ليس _حي() { اذا ابق_الاخير { اطبع(دالة_اطار(عدد - 1)) }; ارجع }
  اساس.اخف_المؤشر()
  خل ارتفاع = 0
  حاول {
    لكل ي في مدى(0, عدد) {
      ارتفاع = _ارسم(دالة_اطار(ي), ارتفاع)
      زمن.نوم(فاصل)
    }
  } امسك (خ) {
    اساس.اظهر_المؤشر()
    ارمي خ
  }
  اساس.اظهر_المؤشر()
  اذا ابق_الاخير { اطبع("") }
  والا { _ارسم("", ارتفاع); اكتب("\r") }
}

دالة _عدد(مدة, معدل) { خل ن = رياضيات.قرب(مدة * معدل); ارجع ن < 2 ? 2 : ن }

// قوس قزح يتحرك على النص
دالة قوس_قزح_متحرك(ن, مدة = 3, سرعة = 1) {
  خل ع = _عدد(مدة, 20)
  شغل_حركة(دالة(ي) { ارجع تدرج.قوس_قزح(ن, {"ازاحة": ي / ع * سرعة * 2, "دوري": صح}) }, ع, 0.05)
}
// تدرج يتحرك على النص (أي مصدر تدرج)
دالة تدرج_متحرك(ن, مصدر, مدة = 3, سرعة = 1) {
  خل ع = _عدد(مدة, 20)
  شغل_حركة(دالة(ي) { ارجع تدرج.تدرج(ن, مصدر, {"ازاحة": ي / ع * سرعة, "ارتداد": صح}) }, ع, 0.05)
}
// نبض: يعلو اللون ويخفت
دالة نبض(ن, ل = "#ff3366", مدة = 2, نبضات = 2) {
  خل ع = _عدد(مدة, 20); خل ا = _ك(ل); خل اسود = لونيات.لون(0, 0, 0)
  شغل_حركة(دالة(ي) {
    اذا ي == ع - 1 { ارجع _ل(ا, ن) }
    خل ف = (1 - رياضيات.جتا(2 * رياضيات.باي * نبضات * ي / ع)) / 2
    ارجع _ل(اسود.امزج(ا, 0.2 + 0.8 * ف), ن)
  }, ع, 0.05)
}
// نيون: وميض كأنه لافتة معطلة ثم يثبت
دالة نيون(ن, ل = "#00ffff", مدة = 2) {
  خل ع = _عدد(مدة, 15); خل ا = _ك(ل); خل خافت = ا.امزج(لونيات.لون(0, 0, 0), 0.7)
  شغل_حركة(دالة(ي) {
    خل مستقر = ي > ع * 0.7
    اذا مستقر او عشوائي.رقم() > 0.35 { ارجع اساس.غامق(_ل(ا, ن)) }
    ارجع _ل(خافت, ن)
  }, ع, 0.07)
}
// تشويش ثم استقرار: كل حرف يستقر في وقته
دالة تشويش(ن, مدة = 1.5, ل = "#00ff9c") {
  خل ع = _عدد(مدة, 25); خل ا = _ك(ل)
  خل رموز = ["▒", "░", "▓", "#", "@", "%", "&", "*", "+", "=", "?", "§"]
  خل ح = اساس.احرف(ن)
  خل وقت = ح.حول(م => م == " " ? 0 : رياضيات.قرب(ع * (0.15 + عشوائي.رقم() * 0.8)))
  شغل_حركة(دالة(ي) {
    خل خ = []
    لكل ف, م في ح {
      اذا ي >= ع - 1 او ي >= وقت[ف] { خ.اضف(م == " " ? " " : _ل(ا, م)) }
      والا { خ.اضف(اساس.خافت(_ل(ا, عشوائي.اختر(رموز)))) }
    }
    ارجع خ.ادمج("")
  }, ع, 0.04)
}
// آلة كاتبة (اختيارياً بتدرج)
دالة كتابة(ن, تاخير = 0.04, مصدر = عدم, مؤشر = "▌") {
  خل ح = اساس.احرف(ن)
  خل ط = ح.طول
  شغل_حركة(دالة(ي) {
    خل خ = []
    لكل ف في مدى(0, رياضيات.اصغر(ي, ط)) {
      خل م = ح[ف]
      خ.اضف(مصدر == عدم ? م : _ل(تدرج.لون_عند(مصدر, ط <= 1 ? 0 : ف / (ط - 1)), م))
    }
    اذا ي < ط { خ.اضف(اساس.خافت(مؤشر)) }
    ارجع خ.ادمج("")
  }, ط + 1, تاخير)
}
// رادار: نقطة ضوء تمسح النص
دالة رادار(ن, مدة = 2, ل = "#ffffff", اساسي = "#555555") {
  خل ع = _عدد(مدة, 25); خل ا = _ك(ل); خل ب = _ك(اساسي)
  خل ح = اساس.احرف(ن); خل ط = ح.طول; خل ن_ = رياضيات.اكبر(3, رياضيات.قرب(ط / 6))
  شغل_حركة(دالة(ي) {
    خل مركز = ي / (ع - 1) * (ط + 2 * ن_) - ن_
    خل خ = []
    لكل ف, م في ح {
      خل ك = 1 - رياضيات.مطلق(ف - مركز) / ن_
      خ.اضف(_ل(ب.امزج(ا, ك > 0 ? ك : 0), م))
    }
    ارجع خ.ادمج("")
  }, ع, 0.04)
}
// كاراوكي: يمتلئ النص باللون تدريجياً
دالة كاراوكي(ن, مدة = 3, ل = "#ffd700", اساسي = "#666666") {
  خل ع = _عدد(مدة, 20); خل ا = _ك(ل); خل ب = _ك(اساسي)
  خل ح = اساس.احرف(ن); خل ط = ح.طول
  شغل_حركة(دالة(ي) {
    خل ق = ي / (ع - 1) * ط
    خل خ = []
    لكل ف, م في ح { خ.اضف(ف < ق ? اساس.غامق(_ل(ا, م)) : _ل(ب, م)) }
    ارجع خ.ادمج("")
  }, ع, 0.05)
}
// تلاشي: "ظهور" من العتمة أو "اختفاء" إليها
دالة تلاشي(ن, ل = "#ffffff", مدة = 1.5, اتجاه = "ظهور") {
  خل ع = _عدد(مدة, 25); خل ا = _ك(ل); خل اسود = لونيات.لون(0, 0, 0)
  شغل_حركة(دالة(ي) {
    خل ت = ي / (ع - 1)
    ارجع _ل(اسود.امزج(ا, اتجاه == "اختفاء" ? 1 - ت : ت), ن)
  }, ع, 0.04, اتجاه != "اختفاء")
}
// موجة لونية تتحرك على النص
دالة موجة(ن, مصدر = "بحر", مدة = 3, طول_موجة = 12) {
  خل ع = _عدد(مدة, 20); خل ح = اساس.احرف(ن)
  شغل_حركة(دالة(ي) {
    خل خ = []
    لكل ف, م في ح {
      خل ت = (رياضيات.جيب(2 * رياضيات.باي * (ف / طول_موجة - ي / ع * 2)) + 1) / 2
      خ.اضف(_ل(تدرج.لون_عند(مصدر, ت), م))
    }
    ارجع خ.ادمج("")
  }, ع, 0.05)
}

// ===================== دوار الانتظار =====================
دالة اسماء_الدوارات() { خل خ = []; لكل ن, ق في بيانات.دوارات { خ.اضف(ن) }; ارجع خ }
دالة _دوار_من(اسم) {
  خل ن = بيانات.دوارات_بديلة.احصل(نص(اسم).صغير()) ?? اسم
  لكل ا, ق في بيانات.دوارات { اذا لونيات.طبع_عربي(ا) == لونيات.طبع_عربي(ن) { ارجع ق } }
  ارمي "دوار غير معروف: ${اسم}"
}

// دوار(نص, {نمط: "نقاط", لون: "سماوي" او تدرج: [...]})
//   د.ابدأ() ثم د.حدث("...") ثم د.انجح("تم") او د.افشل("..") — يعمل مع حلقة الأحداث (الشيفرة غير المتزامنة)
//   وللشيفرة المتزامنة: استدع د.خطوة() يدوياً داخل حلقتك
صنف دوار {
  دالة بناء(ن = "", خيارات = {}) {
    خل م = نوع(خيارات.احصل("اطارات", عدم)) == "قائمة" ? {"اطارات": خيارات["اطارات"], "مدة": 0.1} : _دوار_من(خيارات.احصل("نمط", "نقاط"))
    هذا.اطارات = م["اطارات"]; هذا.مدة = خيارات.احصل("مدة", م["مدة"])
    هذا.نص_ = ن; هذا.ف = 0; هذا.مؤقت = عدم; هذا.خيارات = خيارات; هذا.يعمل = غلط
  }
  دالة _لون_الاطار(ي) {
    خل مصدر = هذا.خيارات.احصل("تدرج", عدم)
    اذا مصدر != عدم { ارجع اساس.لون_من(تدرج.لون_عند(مصدر, (ي % هذا.اطارات.طول) / هذا.اطارات.طول, عدم, صح), هذا.اطارات[ي % هذا.اطارات.طول]) }
    ارجع اساس.نمط(هذا.خيارات.احصل("لون", "سماوي"))(هذا.اطارات[ي % هذا.اطارات.طول])
  }
  دالة سطر() { ارجع هذا._لون_الاطار(هذا.ف) + " " + هذا.نص_ }
  دالة خطوة() {
    هذا.ف += 1
    اذا _حي() { اكتب("\r\x1b[2K" + هذا.سطر()) }
  }
  دالة ابدأ(ن = عدم) {
    اذا ن != عدم { هذا.نص_ = ن }
    هذا.يعمل = صح
    اذا ليس _حي() { ارجع هذا }
    اساس.اخف_المؤشر()
    اكتب("\r\x1b[2K" + هذا.سطر())
    هذا.مؤقت = حلقة.كل(هذا.مدة, دالة() { هذا.خطوة() })
    ارجع هذا
  }
  دالة حدث(ن) { هذا.نص_ = ن; اذا _حي() و هذا.يعمل { اكتب("\r\x1b[2K" + هذا.سطر()) } }
  دالة اوقف(رمز_ = عدم, ن = عدم) {
    اذا هذا.مؤقت != عدم { حلقة.الغ(هذا.مؤقت); هذا.مؤقت = عدم }
    خل كان = هذا.يعمل
    هذا.يعمل = غلط
    اذا _حي() { اكتب("\r\x1b[2K"); اساس.اظهر_المؤشر() }
    خل اخير = ن ?? هذا.نص_
    اذا رمز_ != عدم { اطبع(رمز_ + " " + اخير) }
    والا_اذا كان و ن != عدم { اطبع(اخير) }
  }
  دالة انجح(ن = عدم) { هذا.اوقف(سمة.دور("نجاح")(سمة.رمز_دور("نجاح")), ن) }
  دالة افشل(ن = عدم) { هذا.اوقف(سمة.دور("خطأ")(سمة.رمز_دور("خطأ")), ن) }
  دالة حذر(ن = عدم) { هذا.اوقف(سمة.دور("تحذير")(سمة.رمز_دور("تحذير")), ن) }
  دالة معلومة(ن = عدم) { هذا.اوقف(سمة.دور("معلومة")(سمة.رمز_دور("معلومة")), ن) }
}

// يشغّل عملاً غير متزامن ويعرض دواراً أثناءه: انتظر مع_دوار("جاري التحميل", دالة() {...})
غير_متزامن دالة مع_دوار(ن, عمل, خيارات = {}) {
  خل د = دوار(ن, خيارات)
  د.ابدأ()
  حاول {
    خل نتيجة = انتظر عمل()
    د.انجح()
    ارجع نتيجة
  } امسك (خ) {
    د.افشل("${ن}: ${خ}")
    ارمي خ
  }
}
