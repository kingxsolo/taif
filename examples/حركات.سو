// الحركات والدوارات: solan examples/حركات.سو  (تحتاج طرفية حقيقية)
استورد "زمن"
استورد "../رئيسي"

رئيسي.قوس_قزح_متحرك("طيف · حركات الألوان", 2.5)
رئيسي.تدرج_متحرك("تدرج متحرك على النص", "غروب", 1.5)
رئيسي.نيون("لافتة نيون", "#22d3ee", 1.5)
رئيسي.نبض("نبض القلب ♥", "#fb7185", 2)
رئيسي.تشويش("فك التشفير: الوصول مسموح", 1.5)
رئيسي.كتابة("آلة كاتبة بتدرج ألوان...", 0.04, "سايبر")
رئيسي.رادار("رادار يمسح هذا النص", 2)
رئيسي.كاراوكي("كاراوكي: يمتلئ النص باللون", 3)
رئيسي.موجة("موجة لونية تتحرك على النص", "بحر", 3)
رئيسي.تلاشي("يظهر من العتمة", "#ffffff", 1.2)

// حركة مخصصة: شغّل أي دالة تُرجع نص الإطار
رئيسي.شغل_حركة(دالة(ي) {
  خل ق = ي / 39
  ارجع رئيسي.شريط_تقدم(ق, 30, {"تدرج": "نار"}) + "  ← حركة مخصصة"
}, 40, 0.03)

// دوار مع حلقة الأحداث
خل د = رئيسي.دوار("جاري تحميل الألوان", {"نمط": "نقاط", "تدرج": "بحر"})
د.ابدأ()
حلقة.بعد(1.2, دالة() { د.حدث("جاري التجهيز") })
حلقة.بعد(2.4, دالة() { د.انجح("اكتمل التحميل"); حلقة.اوقف() })
حلقة.شغل()

// شريط تقدم حي
خل ش = رئيسي.شريط(50, {"وصف": "نسخ الملفات", "عرض": 30, "تدرج": "سايبر"})
لكل ي في مدى(0, 50) { ش.تقدم(1); زمن.نوم(0.03) }
ش.اتمم()
