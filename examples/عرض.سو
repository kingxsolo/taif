// عرض شامل لإمكانيات طيف (ثابت، بلا حركات): solan examples/عرض.سو
استورد "../رئيسي"

اطبع("")
اطبع(رئيسي.تدرج("  ╔═══  طيف · مكتبة الألوان لسولان  ═══╗", "قوس_قزح"))
اطبع("")

اطبع(رئيسي.خط("الأنماط والألوان", 60, "─", "وسط", "خافت"))
اطبع(رئيسي.احمر("أحمر") + " " + رئيسي.اخضر_فاتح("أخضر فاتح") + " " + رئيسي.نمط("غامق مسطر #ff8800")("برتقالي غامق مسطر")
     + " " + رئيسي.نمط("قرمزي على كحلي")("قرمزي على كحلي") + " " + رئيسي.شارة_لون("#ffd700", " ذهبي "))
اطبع(رئيسي.وسوم("[غامق]وسوم:[/] [احمر]حمراء[/] [#38bdf8 مائل]سماوية مائلة[/] [غامق احمر على ابيض] تحذير [/] و [تدرج:غروب]غروب بتدرج[/]"))
اطبع("")

اطبع(رئيسي.خط("التدرجات", 60, "─", "وسط", "خافت"))
لكل ن في ["قوس_قزح", "غروب", "بحر", "نار", "غابة", "نيون", "واحة", "حرارة"] {
  اطبع(رئيسي.املأ(ن, 10) + " " + رئيسي.شريط_تدرج(ن, 50, " ", صح))
}
اطبع("")
اطبع(رئيسي.تدرج("نص متعدد الأسطر\nبتدرج قطري يمتد\nعلى كل الأسطر", ["#f43f5e", "#8b5cf6", "#06b6d4"], {"اتجاه": "قطري", "وضع": "كلمة"}))
اطبع("")

اطبع(رئيسي.خط("المزج في المساحات اللونية: أحمر ← أزرق", 60, "─", "وسط", "خافت"))
لكل م في ["rgb", "linear", "hsl", "lch", "oklab", "oklch"] {
  خل س = []
  لكل ي في مدى(0, 41) { س.اضف(رئيسي.لون.من_نص("#ff0000").امزج(رئيسي.لون.من_نص("#0000ff"), ي / 40, م)) }
  اطبع(رئيسي.املأ(م, 8) + " " + س.حول(ل => رئيسي.خلفية_من(ل, " ")).ادمج(""))
}
اطبع("")

اطبع(رئيسي.خط("الإطارات", 60, "─", "وسط", "خافت"))
اطبع(رئيسي.اطار("مرحباً بك في طيف\nمكتبة ألوان وواجهات", {"نمط": "مدور", "عنوان": "طيف", "لون_الاطار": "#a78bfa", "لون_العنوان": "غامق #a78bfa", "محاذاة": "وسط", "حشو": 3, "حشو_راسي": 1}))
اطبع(رئيسي.تنبيه("نجاح", "تم حفظ الملف بنجاح"))
اطبع(رئيسي.تنبيه("تحذير", "المساحة المتبقية قليلة", "تنبيه"))
اطبع(رئيسي.تنبيه("خطأ", "تعذر الاتصال بالخادم"))
اطبع("")

اطبع(رئيسي.خط("الجداول", 60, "─", "وسط", "خافت"))
اطبع(رئيسي.جدول([
  ["القاهرة", 21750000, "مصر"], ["الأقصر", 506000, "مصر"], ["الرياض", 7700000, "السعودية"], ["دبي", 3600000, "الإمارات"]
], {"رؤوس": ["المدينة", "السكان", "الدولة"], "نمط": "مدور", "لون_الاطار": "#64748b", "لون_رأس": "غامق #38bdf8", "مخطط": صح}))
اطبع("")

اطبع(رئيسي.خط("شجرة وقوائم", 60, "─", "وسط", "خافت"))
اطبع(رئيسي.شجرة({"طيف": {"src": {"اساس.سو": "الطرفية", "لونيات.سو": "الألوان"}, "tests": ["اختبار.سو"]}, "README.md": "توثيق"}, {"عنوان": "المشروع", "لون_مفتاح": "غامق #fbbf24"}))
اطبع(رئيسي.قائمة(["الألوان", ["24 بت", "256", "16"], "التدرجات", "الحركات"]))
اطبع("")

اطبع(رئيسي.خط("أشرطة التقدم", 60, "─", "وسط", "خافت"))
لكل ن في ["ناعم", "خطوط", "نقاط", "مربعات"] {
  اطبع(رئيسي.املأ(ن, 8) + " " + رئيسي.شريط_تقدم(0.64, 36, {"نمط": ن, "تدرج": "سايبر"}))
}
اطبع("")

اطبع(رئيسي.خط("المخططات", 60, "─", "وسط", "خافت"))
اطبع(رئيسي.مخطط_اعمدة({"القاهرة": 21.7, "الرياض": 7.7, "دبي": 3.6, "الأقصر": 0.5}, {"عرض": 30, "تدرج": "غروب", "عنوان": "السكان بالملايين"}))
اطبع("")
اطبع("خط صغير: " + رئيسي.خط_صغير([3, 5, 2, 8, 6, 9, 4, 7, 1, 5], "نيون"))
اطبع("")
اطبع(رئيسي.مخطط_خطي([2, 4, 3, 7, 5, 9, 6, 8, 4, 6, 3, 5], {"ارتفاع": 6, "تدرج": "بحر"}))
اطبع("")
اطبع(رئيسي.خريطة_حرارية([[1, 3, 5, 7], [2, 4, 6, 8], [9, 7, 5, 3]], {"قيم": صح, "تسميات_صفوف": ["س", "ص", "ع"], "تسميات_اعمدة": ["أ", "ب", "ج", "د"]}))
اطبع("")
اطبع(رئيسي.مخطط_تكديس({"عربي": 52, "إنجليزي": 28, "فرنسي": 12, "أخرى": 8}, {"عرض": 50}))
اطبع("")

اطبع(رئيسي.خط("الألوان ككائنات", 60, "─", "وسط", "خافت"))
اطبع(رئيسي.معاينة("#6366f1"))
خل اساس = رئيسي.لون.من_نص("#6366f1")
اطبع("تناسق ثلاثي : " + رئيسي.لوحة(اساس.تناسق("ثلاثي"), {"عرض_خلية": 10, "تسميات": غلط}))
اطبع("درجات      : " + رئيسي.لوحة(اساس.درجات(11), {"عرض_خلية": 4, "تسميات": غلط}))
اطبع("")

اطبع(رئيسي.خط("السمات", 60, "─", "وسط", "خافت"))
لكل س في ["افتراضي", "دراكولا", "نورد", "مونوكاي", "طوكيو"] {
  رئيسي.ضبط_سمة(س)
  اطبع(رئيسي.املأ(س, 10) + " " + رئيسي.نجاح("نجاح") + "  " + رئيسي.خطأ("خطأ") + "  " + رئيسي.تحذير("تحذير") + "  " + رئيسي.معلومة("معلومة"))
}
رئيسي.ضبط_سمة("افتراضي")
اطبع("")
اطبع(رئيسي.قارن_المستويات("قوس_قزح", 50))
اطبع("")
اطبع(رئيسي.تشخيص())
